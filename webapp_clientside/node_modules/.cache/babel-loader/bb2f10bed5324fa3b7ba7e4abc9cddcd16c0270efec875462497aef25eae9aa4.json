{"ast":null,"code":"export default {\n  name: 'PageHeader',\n  props: {\n    title: {\n      type: String,\n      required: true\n    },\n    lead: {\n      type: String,\n      default: ''\n    },\n    icon: {\n      type: String,\n      default: '🌿'\n    }\n  }\n};","map":{"version":3,"names":["name","props","title","type","String","required","lead","default","icon"],"sources":["/Users/jackyzhang/webapp_clientside/src/components/PageHeader.vue"],"sourcesContent":["<template>\n  <section class=\"page-header\">\n    <div class=\"header-bg\" aria-hidden=\"true\"></div>\n    <div class=\"container\">\n      <router-link to=\"/\" class=\"back-link\">← Back to home</router-link>\n\n      <div class=\"head-row\">\n        <span class=\"head-icon\" aria-hidden=\"true\">{{ icon }}</span>\n        <div>\n          <h1>{{ title }}</h1>\n          <p v-if=\"lead\">{{ lead }}</p>\n        </div>\n      </div>\n\n      <!-- Barre d'outils optionnelle (recherche, filtres...) -->\n      <div v-if=\"$slots.default\" class=\"head-tools\">\n        <slot />\n      </div>\n    </div>\n  </section>\n</template>\n\n<script>\nexport default {\n  name: 'PageHeader',\n  props: {\n    title: { type: String, required: true },\n    lead: { type: String, default: '' },\n    icon: { type: String, default: '🌿' }\n  }\n}\n</script>\n\n<style scoped>\n.page-header {\n  position: relative;\n  overflow: hidden;\n  padding: 28px 0 56px;\n  background: var(--forest);\n  color: #fff;\n  border-bottom-right-radius: 64px;\n  border-bottom-left-radius: 8px;\n}\n\n.header-bg {\n  position: absolute;\n  top: -120px;\n  right: -80px;\n  width: 380px;\n  height: 380px;\n  background: var(--green);\n  opacity: 0.55;\n  border-radius: 190px 20px 190px 20px;\n  transform: rotate(18deg);\n}\n\n.container {\n  position: relative;\n}\n\n.back-link {\n  display: inline-block;\n  padding: 7px 16px;\n  border: 1px solid rgba(255, 255, 255, 0.35);\n  border-radius: 999px;\n  color: #fff;\n  font-size: 0.88rem;\n  font-weight: 700;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.back-link:hover {\n  background: #fff;\n  color: var(--forest);\n}\n\n.head-row {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  margin-top: 30px;\n}\n\n.head-icon {\n  display: grid;\n  place-items: center;\n  flex-shrink: 0;\n  width: 74px;\n  height: 74px;\n  background: rgba(255, 255, 255, 0.12);\n  border-radius: 24px 6px 24px 6px;\n  font-size: 2.2rem;\n}\n\nh1 {\n  font-size: clamp(2rem, 4vw, 3rem);\n  font-weight: 800;\n}\n\n.head-row p {\n  margin-top: 8px;\n  max-width: 560px;\n  color: var(--mint);\n  font-size: 1.05rem;\n}\n\n.head-tools {\n  margin-top: 30px;\n}\n\n@media (max-width: 560px) {\n  .head-row {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n</style>"],"mappings":"AAuBA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,KAAK,EAAE;MAAEC,IAAI,EAAEC,MAAM;MAAEC,QAAQ,EAAE;IAAK,CAAC;IACvCC,IAAI,EAAE;MAAEH,IAAI,EAAEC,MAAM;MAAEG,OAAO,EAAE;IAAG,CAAC;IACnCC,IAAI,EAAE;MAAEL,IAAI,EAAEC,MAAM;MAAEG,OAAO,EAAE;IAAK;EACtC;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}