{"ast":null,"code":"export default {\n  name: 'HelloWorld',\n  props: {\n    msg: String\n  }\n};","map":{"version":3,"names":["name","props","msg","String"],"sources":["/Users/jackyzhang/webapp_clientside/src/components/HelloWord.vue"],"sourcesContent":["<template>\n  <router-view />\n  <div class=\"happyzoo-wrapper\">\n    <header class=\"menu-haut\">\n      <div class=\"container conteneur-nav\">\n        <a href=\"#\" class=\"mon-logo\"> 🌿Happy<span>Zoo</span></a>\n        <nav class=\"liens-nav\">\n          <router-link to=\"/\">Home</router-link>\n          <router-link to=\"/animals\">Animals</router-link>\n          <a href=\"#zones\">Zones & Universes</a>\n          <a href=\"#activites\">Experiences</a>\n          <a href=\"#tarifs\">Tickets</a>\n        </nav>\n\n        <div class=\"boutons-nav\">\n          <a href=\"#\" class=\"bouton-moncompte\">My Account</a>\n          <a href=\"#tarifs\" class=\"bouton-reserver\">Book Now</a>\n        </div>\n      </div>\n    </header>\n\n    <section class=\"grand-banner\">\n      <div class=\"fond-sombre\"></div>\n      <div class=\"container contenu-banner\">\n        <span class=\"petit-badge\">An unforgettable adventure</span>\n        <h1>Explore wildlife closer to nature</h1>\n        <p>Wander through over 5 preserved thematic zones and meet more than 200 fascinating animal species.</p>\n        <div class=\"bloc-boutons\">\n          <a href=\"#tarifs\" class=\"bouton-reserver grand-bouton\">Get my tickets</a>\n          <a href=\"#zones\" class=\"bouton-decouvrir grand-bouton\">Discover the zones</a>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"zones\" class=\"section-zones\">\n      <div class=\"container\">\n        <div class=\"titre-section\">\n          <span class=\"tag-titre\">Trails &amp; Habitats</span>\n          <h2>Explore our Thematic Zones</h2>\n          <p>Each zone is specially designed to respect the natural biotope of our residents.</p>\n        </div>\n\n        <div class=\"grille-3-colonnes\">\n          <article class=\"zone1\">\n            <div class=\"boite-image\" style=\"background-image: url('https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&amp;fit=crop&amp;w=800&amp;q=80');\">\n              <span class=\"etiquette\">African Savannah</span>\n            </div>\n            <div class=\"contenu-texte\">\n              <h3>Land of Lions &amp; Giraffes</h3>\n              <p>A vast sunny plain reproducing the arid steppes of East Africa.</p>\n\n              <div class=\"info-surface\">\n                <span>Area: 45,000 m²</span>\n              </div>\n            </div>\n          </article>\n\n          <article class=\"zone2\">\n            <div class=\"boite-image\" style=\"background-image: url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&amp;fit=crop&amp;w=800&amp;q=80');\">\n              <span class=\"etiquette\">Tropical Forest</span>\n            </div>\n            <div class=\"contenu-texte\">\n              <h3>Amazonian Dome</h3>\n              <p>A lush, humid and warm environment welcoming monkeys, reptiles and toucans.</p>\n\n              <div class=\"info-surface\">\n                <span>Area: 20,000 m²</span>\n              </div>\n            </div>\n          </article>\n\n          <article class=\"zone3\">\n            <div class=\"boite-image\" style=\"background-image: url('https://images.unsplash.com/photo-1548247416-ec66f4900b2e?auto=format&amp;fit=crop&amp;w=800&amp;q=80');\">\n              <span class=\"etiquette\">Polar World</span>\n            </div>\n            <div class=\"contenu-texte\">\n              <h3>Ice Floes &amp; Fjords</h3>\n              <p>Fresh filtered water pool and slippery rocks for penguins and polar bears.</p>\n\n              <div class=\"info-surface\">\n                <span>Area: 15,000 m²</span>\n              </div>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"activites\" class=\"section-soigneur\">\n      <div class=\"container bloc-promo\">\n        <div class=\"texte-promo\">\n          <span class=\"tag-titre\">Closer to the beasts</span>\n          <h2>Become a Keeper for a Day</h2>\n          <p>Take part in supervised feeding with our animal team and understand the lifestyle and diet of our favorite species.</p>\n\n          <a href=\"#\" class=\"bouton-reserver\">Book a workshop</a>\n        </div>\n        <div class=\"image-promo\">\n          <img src=\"https://images.unsplash.com/photo-1535268647677-300dbf3d78d1?auto=format&amp;fit=crop&amp;w=800&amp;q=80\" alt=\"Animal interaction\" />\n        </div>\n      </div>\n    </section>\n\n    <section id=\"tarifs\" class=\"section-tarifs fond-gris\">\n      <div class=\"container\">\n        <div class=\"titre-section\">\n          <span class=\"tag-titre\">Online Ticketing</span>\n          <h2>Choose Your Package</h2>\n          <p>Buy your tickets in advance to avoid waiting at the checkout.</p>\n        </div>\n\n        <div class=\"grille-3-colonnes\">\n          <div class=\"billet1\">\n            <h3>Child Ticket</h3>\n            <p class=\"sous-titre\">3 to 12 years old included</p>\n            <div class=\"prix\">14€<span>/pers</span></div>\n            <ul class=\"liste-avantages\">\n              <li>✔ Full access to zones</li>\n              <li>✔ Animations &amp; animated snacks</li>\n              <li>✔ Fun map included</li>\n            </ul>\n            <button class=\"bouton-acheter\">Buy</button>\n          </div>\n\n          <div class=\"billet2 populaire\">\n            <span class=\"tag-populaire\">Most popular</span>\n            <h3>Adult Ticket</h3>\n            <p class=\"sous-titre\">From 13 years old</p>\n            <div class=\"prix\">22€<span>/pers</span></div>\n            <ul class=\"liste-avantages\">\n              <li>✔ Unlimited access to all zones</li>\n              <li>✔ Access to educational shows</li>\n              <li>✔ Skip-the-line entry</li>\n            </ul>\n            <button class=\"bouton-acheter full-btn\">Buy</button>\n          </div>\n\n          <div class=\"billet3\">\n            <h3>Family Pass</h3>\n            <p class=\"sous-titre\">2 Adults + 2 Children</p>\n            <div class=\"prix\">62€<span>/pack</span></div>\n            <ul class=\"liste-avantages\">\n              <li>✔ Advantageous combined ticket</li>\n              <li>✔ Interactive mobile guide</li>\n              <li>✔ 10% off in our restaurants</li>\n            </ul>\n            <button class=\"bouton-acheter\">Buy</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <footer class=\"pied-de-page\">\n      <div class=\"container colonnes-footer\">\n        <div class=\"colonne1\">\n          <div class=\"mon-logo\">🌿 Zoo<span>WildLife</span></div>\n          <p>A park committed to wildlife preservation and public awareness.</p>\n        </div>\n        <div class=\"colonne2\">\n          <h4>Navigation</h4>\n          <ul>\n            <li><a href=\"#zones\">The Zones</a></li>\n            <li><a href=\"#activites\">Experiences</a></li>\n            <li><a href=\"#tarifs\">Tickets &amp; Prices</a></li>\n          </ul>\n        </div>\n        <div class=\"colonne3\">\n          <h4>Opening Hours</h4>\n          <p>Monday to Sunday<br />09:30 AM to 06:30 PM</p>\n          <p>Ticket offices close at 05:00 PM</p>\n        </div>\n        <div class=\"colonne4\">\n          <h4>Contact</h4>\n          <p>📍 Reserve Road, 75000 Paris</p>\n          <p>📞 01 23 45 67 89</p>\n          <p>✉ contact@zoowildlife.fr</p>\n        </div>\n      </div>\n      <div class=\"bas-du-footer\">\n        <p>&copy; 2026 Zoo WildLife. All rights reserved.</p>\n      </div>\n    </footer>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'HelloWorld',\n  props: {\n    msg: String\n  }\n}\n</script>\n\n<style scoped>\n* {\n  margin: 0;\n  padding: 