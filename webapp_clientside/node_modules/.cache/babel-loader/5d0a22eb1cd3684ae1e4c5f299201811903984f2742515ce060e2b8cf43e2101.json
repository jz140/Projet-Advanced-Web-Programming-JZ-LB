{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport animals from '@/assets/ANIMAL.json';\nimport zones from '@/assets/ZONE.json';\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle';\nimport { getTicketTypes } from '@/utils/ticketTypes';\nimport TicketStub from '@/components/TicketStub.vue';\nfunction formatWeight(kg) {\n  if (kg < 1) return Math.round(kg * 1000) + ' g';\n  return kg.toLocaleString('en-US') + ' kg';\n}\nexport default {\n  name: 'HelloWorld',\n  components: {\n    TicketStub\n  },\n  data() {\n    return {\n      animals,\n      zones,\n      tickets: getTicketTypes(),\n      showKeeper: false\n    };\n  },\n  computed: {\n    minPrice() {\n      return Math.min(...this.tickets.map(t => t.price));\n    },\n    // Aquarium, Savannah, Arctic : les 3 zones mises en avant sur l'accueil\n    featuredZones() {\n      return [1, 2, 5].map(id => this.zones.find(zone => zone.id_zone === id)).filter(Boolean);\n    },\n    records() {\n      const biggest = key => this.animals.reduce((a, b) => b[key] > a[key] ? b : a);\n      const smallest = key => this.animals.reduce((a, b) => b[key] < a[key] ? b : a);\n      const heaviest = biggest('weight_animal');\n      const tallest = biggest('height_animal');\n      const lightest = smallest('weight_animal');\n      return [{\n        label: 'Heaviest',\n        emoji: '⚖️',\n        animal: heaviest,\n        value: formatWeight(heaviest.weight_animal)\n      }, {\n        label: 'Tallest',\n        emoji: '📏',\n        animal: tallest,\n        value: tallest.height_animal + ' m'\n      }, {\n        label: 'Lightest',\n        emoji: '🪶',\n        animal: lightest,\n        value: formatWeight(lightest.weight_animal)\n      }];\n    }\n  },\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n    countAnimals(idZone) {\n      return this.animals.filter(animal => animal.id_zone === idZone).length;\n    },\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone);\n      return zone ? zone.name_zone : '';\n    }\n  }\n};","map":{"version":3,"names":["animals","zones","zoneEmoji","zoneBackground","getTicketTypes","TicketStub","formatWeight","kg","Math","round","toLocaleString","name","components","data","tickets","showKeeper","computed","minPrice","min","map","t","price","featuredZones","id","find","zone","id_zone","filter","Boolean","records","biggest","key","reduce","a","b","smallest","heaviest","tallest","lightest","label","emoji","animal","value","weight_animal","height_animal","methods","countAnimals","idZone","length","zoneName","z","name_zone"],"sources":["/Users/jackyzhang/webapp_clientside/src/components/HelloWord.vue"],"sourcesContent":["<template>\n  <div class=\"home\">\n\n    <!-- ========== BANNIÈRE ========== -->\n    <section class=\"hero\">\n      <div class=\"hero-bg\" aria-hidden=\"true\">\n        <span class=\"blob blob-1\"></span>\n        <span class=\"blob blob-2\"></span>\n      </div>\n\n      <div class=\"container hero-grid\">\n        <div class=\"hero-text\">\n          <span class=\"badge\">An unforgettable adventure</span>\n          <h1>Explore wildlife closer to nature</h1>\n          <p class=\"lead\">\n            Wander through {{ zones.length }} themed zones and meet\n            {{ animals.length }} fascinating animals.\n          </p>\n\n          <div class=\"hero-actions\">\n            <router-link to=\"/tickets\" class=\"btn btn-orange btn-lg\">Get my tickets</router-link>\n            <router-link to=\"/zones\" class=\"btn btn-light btn-lg\">Discover the zones</router-link>\n          </div>\n        </div>\n\n        <!-- Petit billet \"aujourd'hui\" -->\n        <aside class=\"today\" aria-label=\"Today at HappyZoo\">\n          <div class=\"today-top\">\n            <small>Open today</small>\n            <strong>09:30 – 18:30</strong>\n            <span>Last entry at 17:00</span>\n          </div>\n          <div class=\"today-foot\">\n            <div>\n              <small>Tickets from</small>\n              <strong>{{ minPrice }}€</strong>\n            </div>\n            <router-link to=\"/tickets\" class=\"btn btn-orange btn-sm\">Book now</router-link>\n          </div>\n        </aside>\n      </div>\n\n      <!-- Les 10 habitats : un clic ouvre la liste des animaux de la zone -->\n      <div class=\"container\">\n        <nav class=\"habitats\" aria-label=\"Pick a habitat\">\n          <p class=\"habitats-title\">Pick a habitat</p>\n          <ul>\n            <li v-for=\"zone in zones\" :key=\"zone.id_zone\">\n              <router-link :to=\"{ path: '/animals', query: { zone: zone.id_zone } }\" class=\"habitat\">\n                <span class=\"habitat-dot\" :style=\"{ background: zoneBackground(zone.id_zone) }\">\n                  {{ zoneEmoji(zone.id_zone) }}\n                </span>\n                <span class=\"habitat-name\">{{ zone.name_zone }}</span>\n              </router-link>\n            </li>\n          </ul>\n        </nav>\n      </div>\n    </section>\n\n    <!-- ========== ZONES MISES EN AVANT ========== -->\n    <section class=\"section section-first\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div>\n            <h2>Explore our thematic zones</h2>\n            <p>Each zone is designed to respect the natural biotope of its residents.</p>\n          </div>\n          <router-link to=\"/zones\" class=\"more\">See all {{ zones.length }} zones →</router-link>\n        </div>\n\n        <div class=\"zone-grid\">\n          <article v-for=\"zone in featuredZones\" :key=\"zone.id_zone\" class=\"zcard\">\n            <div class=\"zcard-top\" :style=\"{ background: zoneBackground(zone.id_zone) }\">\n              <span class=\"chip\">{{ zone.theme_zone }}</span>\n              <span class=\"zcard-emoji\" aria-hidden=\"true\">{{ zoneEmoji(zone.id_zone) }}</span>\n            </div>\n            <div class=\"zcard-body\">\n              <h3>{{ zone.name_zone }}</h3>\n              <p>{{ zone.description_zone }}</p>\n              <div class=\"zcard-meta\">\n                <span>{{ zone.place_zone }}</span>\n                <span>{{ countAnimals(zone.id_zone) }} animals</span>\n              </div>\n              <router-link :to=\"{ path: '/animals', query: { zone: zone.id_zone } }\" class=\"zcard-link\">\n                See the animals →\n              </router-link>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- ========== RECORDS (calculés avec ANIMAL.json) ========== -->\n    <section class=\"section records-section\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div>\n            <h2>The big and the small</h2>\n            <p>A few records among our {{ animals.length }} residents.</p>\n          </div>\n          <router-link to=\"/animals\" class=\"more\">Meet all the animals →</router-link>\n        </div>\n\n        <div class=\"records\">\n          <router-link\n            v-for=\"record in records\"\n            :key=\"record.label\"\n            :to=\"{ path: '/animals', query: { zone: record.animal.id_zone } }\"\n            class=\"record\"\n          >\n            <span class=\"record-emoji\" aria-hidden=\"true\">{{ record.emoji }}</span>\n            <small>{{ record.label }}</small>\n            <h3>{{ record.animal.species_animal }}</h3>\n            <strong>{{ record.value }}</strong>\n            <span class=\"record-zone\">{{ zoneName(record.animal.id_zone) }}</span>\n          </router-link>\n        </div>\n      </div>\n    </section>\n\n    <!-- ========== PETIT BLOC KEEPER (HTML + CSS + un peu de JS) ========== -->\n    <section class=\"section\">\n      <div class=\"container\">\n        <div class=\"keeper\">\n          <div class=\"keeper-text\">\n            <span class=\"badge badge-orange\">Closer to the beasts</span>\n            <h2>Become a Keeper for a Day</h2>\n            <p>\n              Take part in supervised feedings with our animal team and discover\n              how our favourite species live and eat.\n            </p>\n            <!-- Le petit bout de JS : ce bouton affiche / cache la liste -->\n            <button\n              type=\"button\"\n              class=\"btn btn-light\"\n              :aria-expanded=\"showKeeper\"\n              @click=\"showKeeper = !showKeeper\"\n            >\n              {{ showKeeper ? 'Hide details' : \"What's included?\" }}\n            </button>\n          </div>\n\n          <ul v-if=\"showKeeper\" class=\"keeper-list\">\n            <li>Keeper outfit to keep</li>\n            <li>Behind-the-scenes access</li>\n            <li>Supervised feeding</li>\n            <li>Souvenir photo</li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <!-- ========== BILLETS ========== -->\n    <section class=\"section tickets-section\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div>\n            <h2>Choose your ticket</h2>\n            <p>Buy in advance to skip the line at the entrance.</p>\n          </div>\n          <router-link to=\"/tickets\" class=\"more\">Go to tickets →</router-link>\n        </div>\n\n        <div class=\"ticket-grid\">\n          <TicketStub v-for=\"ticket in tickets\" :key=\"ticket.id\" :ticket=\"ticket\">\n            <router-link to=\"/tickets\" class=\"btn btn-sm\" :class=\"ticket.popular ? 'btn-orange' : 'btn-outline'\">\n              Choose\n            </router-link>\n          </TicketStub>\n        </div>\n      </div>\n    </section>\n\n  </div>\n</template>\n\n<script>\nimport animals from '@/assets/ANIMAL.json'\nimport zones from '@/assets/ZONE.json'\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle'\nimport { getTicketTypes } from '@/utils/ticketTypes'\nimport TicketStub from '@/components/TicketStub.vue'\n\nfunction formatWeight(kg) {\n  if (kg < 1) return Math.round(kg * 1000) + ' g'\n  return kg.toLocaleString('en-US') + ' kg'\n}\n\nexport default {\n  name: 'HelloWorld',\n\n  components: { TicketStub },\n\n  data() {\n    return {\n      animals,\n      zones,\n      tickets: getTicketTypes(),\n      showKeeper: false\n    }\n  },\n\n  computed: {\n    minPrice() {\n      return Math.min(...this.tickets.map(t => t.price))\n    },\n\n    // Aquarium, Savannah, Arctic : les 3 zones mises en avant sur l'accueil\n    featuredZones() {\n      return [1, 2, 5]\n        .map(id => this.zones.find(zone => zone.id_zone === id))\n        .filter(Boolean)\n    },\n\n    records() {\n      const biggest = key => this.animals.reduce((a, b) => (b[key] > a[key] ? b : a))\n      const smallest = key => this.animals.reduce((a, b) => (b[key] < a[key] ? b : a))\n\n      const heaviest = biggest('weight_animal')\n      const tallest = biggest('height_animal')\n      const lightest = smallest('weight_animal')\n\n      return [\n        { label: 'Heaviest', emoji: '⚖️', animal: heaviest, value: formatWeight(heaviest.weight_animal) },\n        { label: 'Tallest', emoji: '📏', animal: tallest, value: tallest.height_animal + ' m' },\n        { label: 'Lightest', emoji: '🪶', animal: lightest, value: formatWeight(lightest.weight_animal) }\n      ]\n    }\n  },\n\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n\n    countAnimals(idZone) {\n      return this.animals.filter(animal => animal.id_zone === idZone).length\n    },\n\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone)\n      return zone ? zone.name_zone : ''\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* ---------- Bannière ---------- */\n\n.hero {\n  position: relative;\n  padding: 70px 0 0;\n  background: var(--forest);\n  color: #fff;\n  border-bottom-left-radius: 8px;\n  border-bottom-right-radius: 64px;\n}\n\n.hero-bg {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  border-bottom-right-radius: 64px;\n}\n\n.blob {\n  position: absolute;\n  background: var(--green);\n  border-radius: 50% 8% 50% 8%;\n}\n\n.blob-1 {\n  top: -140px;\n  right: -60px;\n  width: 460px;\n  height: 460px;\n  opacity: 0.5;\n  transform: rotate(20deg);\n}\n\n.blob-2 {\n  bottom: 40px;\n  left: -120px;\n  width: 280px;\n  height: 280px;\n  opacity: 0.3;\n  transform: rotate(-12deg);\n}\n\n.hero-grid {\n  position: relative;\n  display: grid;\n  grid-template-columns: 1.4fr 1fr;\n  gap: 50px;\n  align-items: center;\n}\n\n.badge {\n  display: inline-block;\n  padding: 5px 14px;\n  border-radius: 999px;\n  background: var(--sand);\n  color: var(--forest);\n  font-size: 0.82rem;\n  font-weight: 700;\n}\n\n.badge-orange {\n  background: var(--orange);\n  color: #fff;\n}\n\n.hero h1 {\n  margin: 18px 0 16px;\n  font-size: clamp(2.4rem, 5.5vw, 4.2rem);\n  font-weight: 800;\n  letter-spacing: -0.02em;\n}\n\n.lead {\n  max-width: 520px;\n  color: var(--mint);\n  font-size: 1.18rem;\n}\n\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px;\n  margin-top: 32px;\n}\n\n/* Billet \"aujourd'hui\" */\n\n.today {\n  position: relative;\n  background: #fff;\n  color: var(--ink);\n  border-radius: var(--leaf-radius);\n  transform: rotate(2deg);\n  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);\n}\n\n.today-top {\n  padding: 28px 28px 22px;\n}\n\n.today small,\n.today span {\n  display: block;\n  color: var(--muted);\n  font-size: 0.88rem;\n}\n\n.today-top strong {\n  display: block;\n  margin: 4px 0;\n  font-family: var(--font-display);\n  font-size: 2.2rem;\n  color: var(--forest);\n}\n\n.today-foot {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 20px 28px 24px;\n  border-top: 2px dashed var(--line);\n}\n\n.today-foot::before,\n.today-foot::after {\n  content: '';\n  position: absolute;\n  top: -15px;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: var(--forest);\n}\n\n.today-foot::before { left: -14px; }\n.today-foot::after { right: -14px; }\n\n.today-foot strong {\n  font-family: var(--font-display);\n  font-size: 1.8rem;\n  color: var(--orange);\n}\n\n/* Habitats */\n\n.habitats {\n  position: relative;\n  top: 62px;\n  margin-top: 54px;\n  padding: 22px 24px 20px;\n  background: #fff;\n  color: var(--ink);\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n}\n\n.habitats-title {\n  margin-bottom: 14px;\n  font-family: var(--font-display);\n  font-weight: 700;\n  color: var(--forest);\n}\n\n.habitats ul {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  margin: 0;\n  padding: 0 0 4px;\n  overflow-x: auto;\n  list-style: none;\n}\n\n.habitat {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  min-width: 84px;\n}\n\n.habitat-dot {\n  display: grid;\n  place-items: center;\n  width: 58px;\n  height: 58px;\n  border-radius: 20px 5px 20px 5px;\n  font-size: 1.7rem;\n  transition: transform 0.2s;\n}\n\n.habitat:hover .habitat-dot {\n  transform: rotate(-6deg) scale(1.08);\n}\n\n.habitat-name {\n  font-size: 0.8rem;\n  font-weight: 700;\n  color: var(--forest);\n  text-align: center;\n}\n\n/* ---------- Sections ---------- */\n\n.section {\n  padding: 70px 0;\n}\n\n.section-first {\n  padding-top: 150px;\n}\n\n.section-head {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 16px;\n  margin-bottom: 34px;\n}\n\n.section-head h2 {\n  font-size: clamp(1.8rem, 3.5vw, 2.5rem);\n  color: var(--forest);\n}\n\n.section-head p {\n  margin-top: 8px;\n  color: var(--muted);\n}\n\n.more {\n  font-weight: 700;\n  color: var(--orange);\n}\n\n.more:hover {\n  color: var(--orange-dark);\n  text-decoration: underline;\n}\n\n/* Cartes de zones */\n\n.zone-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));\n  gap: 28px;\n}\n\n.zcard {\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n}\n\n.zcard-top {\n  position: relative;\n  height: 180px;\n  padding: 16px;\n}\n\n.chip {\n  display: inline-block;\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: #fff;\n  color: var(--forest);\n  font-size: 0.78rem;\n  font-weight: 700;\n}\n\n.zcard-emoji {\n  position: absolute;\n  right: 22px;\n  bottom: 14px;\n  font-size: 4.4rem;\n  line-height: 1;\n}\n\n.zcard-body {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  padding: 24px;\n}\n\n.zcard-body h3 {\n  color: var(--forest);\n  font-size: 1.5rem;\n}\n\n.zcard-body p {\n  margin-top: 8px;\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n.zcard-meta {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 18px;\n  padding-top: 14px;\n  border-top: 1px solid var(--line);\n  color: var(--green);\n  font-size: 0.86rem;\n  font-weight: 700;\n}\n\n.zcard-link {\n  margin-top: auto;\n  padding-top: 16px;\n  font-weight: 700;\n  color: var(--orange);\n}\n\n.zcard-link:hover {\n  color: var(--orange-dark);\n  text-decoration: underline;\n}\n\n/* Records */\n\n.records-section {\n  background: var(--meadow);\n}\n\n.records {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 24px;\n}\n\n.record {\n  position: relative;\n  padding: 28px;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n  transition: box-shadow 0.2s;\n}\n\n.record:hover {\n  box-shadow: 0 0 0 2px var(--green), var(--shadow);\n}\n\n.record-emoji {\n  position: absolute;\n  top: 22px;\n  right: 24px;\n  font-size: 2rem;\n}\n\n.record small {\n  color: var(--orange);\n  font-weight: 700;\n  font-size: 0.9rem;\n}\n\n.record h3 {\n  margin: 6px 0 10px;\n  color: var(--forest);\n  font-size: 1.5rem;\n}\n\n.record strong {\n  display: block;\n  font-family: var(--font-display);\n  font-size: 2.3rem;\n  color: var(--green);\n}\n\n.record-zone {\n  display: inline-block;\n  margin-top: 12px;\n  padding: 3px 12px;\n  border-radius: 999px;\n  background: var(--mint);\n  color: var(--forest);\n  font-size: 0.8rem;\n  font-weight: 700;\n}\n\n/* Petit bloc Keeper */\n\n.keeper {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 28px;\n  padding: 36px 40px;\n  background: var(--forest);\n  color: #fff;\n  border-radius: 48px 8px 48px 8px;\n}\n\n.keeper-text {\n  max-width: 520px;\n}\n\n.keeper h2 {\n  margin: 12px 0 10px;\n  font-size: clamp(1.6rem, 3vw, 2.2rem);\n}\n\n.keeper p {\n  margin-bottom: 20px;\n  color: var(--mint);\n}\n\n.keeper-list {\n  min-width: 260px;\n  margin: 0;\n  padding: 22px 26px;\n  list-style: none;\n  background: rgba(255, 255, 255, 0.08);\n  border-radius: var(--leaf-radius);\n}\n\n.keeper-list li {\n  position: relative;\n  padding: 7px 0 7px 26px;\n}\n\n.keeper-list li::before {\n  content: '✔';\n  position: absolute;\n  left: 0;\n  color: var(--leaf);\n  font-weight: 700;\n}\n\n/* Billets */\n\n.tickets-section {\n  --notch: var(--cream);\n}\n\n.ticket-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));\n  gap: 28px;\n}\n\n/* ---------- Mobile ---------- */\n\n@media (max-width: 900px) {\n  .hero-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .today {\n    max-width: 380px;\n  }\n\n  .keeper {\n    padding: 28px 24px;\n  }\n\n  .section-first {\n    padding-top: 140px;\n  }\n}\n</style>"],"mappings":";;;;;AAkLA,OAAOA,OAAM,MAAO,sBAAqB;AACzC,OAAOC,KAAI,MAAO,oBAAmB;AACrC,SAASC,SAAS,EAAEC,cAAa,QAAS,mBAAkB;AAC5D,SAASC,cAAa,QAAS,qBAAoB;AACnD,OAAOC,UAAS,MAAO,6BAA4B;AAEnD,SAASC,YAAYA,CAACC,EAAE,EAAE;EACxB,IAAIA,EAAC,GAAI,CAAC,EAAE,OAAOC,IAAI,CAACC,KAAK,CAACF,EAAC,GAAI,IAAI,IAAI,IAAG;EAC9C,OAAOA,EAAE,CAACG,cAAc,CAAC,OAAO,IAAI,KAAI;AAC1C;AAEA,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,UAAU,EAAE;IAAEP;EAAW,CAAC;E