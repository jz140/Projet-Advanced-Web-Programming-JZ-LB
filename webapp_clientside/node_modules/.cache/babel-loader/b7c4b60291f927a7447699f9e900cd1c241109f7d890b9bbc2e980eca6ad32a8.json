{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport animals from '@/assets/ANIMAL.json';\nimport zones from '@/assets/ZONE.json';\nexport default {\n  name: 'NavBar',\n  data() {\n    return {\n      open: false,\n      closeTimer: null,\n      lastPointer: ''\n    };\n  },\n  computed: {\n    animalCount() {\n      return animals.length;\n    },\n    zoneCount() {\n      return zones.length;\n    },\n    // \"Data\" est surligné quand on est sur /animals ou /zones\n    dataActive() {\n      return ['/animals', '/zones'].includes(this.$route.path);\n    }\n  },\n  watch: {\n    // On referme le menu à chaque changement de page\n    '$route'() {\n      this.open = false;\n    }\n  },\n  mounted() {\n    document.addEventListener('click', this.onDocumentClick);\n  },\n  beforeUnmount() {\n    document.removeEventListener('click', this.onDocumentClick);\n    clearTimeout(this.closeTimer);\n  },\n  methods: {\n    onEnter(event) {\n      this.lastPointer = event.pointerType;\n      if (event.pointerType === 'mouse') {\n        clearTimeout(this.closeTimer);\n        this.open = true;\n      }\n    },\n    onLeave(event) {\n      if (event.pointerType === 'mouse') {\n        // petit délai pour ne pas fermer si le curseur dévie un instant\n        this.closeTimer = setTimeout(() => {\n          this.open = false;\n        }, 150);\n      }\n    },\n    onToggle() {\n      // Souris : le survol l'a déjà ouvert, un clic ne doit pas le refermer\n      if (this.lastPointer === 'mouse') {\n        this.open = true;\n      } else {\n        this.open = !this.open;\n      }\n    },\n    onFocusOut(event) {\n      const next = event.relatedTarget;\n      if (next && !this.$refs.dropdown.contains(next)) {\n        this.open = false;\n      }\n    },\n    onDocumentClick(event) {\n      if (this.$refs.dropdown && !this.$refs.dropdown.contains(event.target)) {\n        this.open = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["animals","zones","name","data","open","closeTimer","lastPointer","computed","animalCount","length","zoneCount","dataActive","includes","$route","path","watch","mounted","document","addEventListener","onDocumentClick","beforeUnmount","removeEventListener","clearTimeout","methods","onEnter","event","pointerType","onLeave","setTimeout","onToggle","onFocusOut","next","relatedTarget","$refs","dropdown","contains","target"],"sources":["/Users/jackyzhang/webapp_clientside/src/components/NavBar.vue"],"sourcesContent":["<template>\n  <header class=\"menu-haut\">\n    <div class=\"container conteneur-nav\">\n      <router-link to=\"/\" class=\"mon-logo\">🌿Happy<span>Zoo</span></router-link>\n\n      <nav class=\"liens-nav\" aria-label=\"Main navigation\">\n        <router-link to=\"/\" class=\"nav-link\">Home</router-link>\n\n        <!-- Menu déroulant \"Data\" : s'ouvre au survol, un clic sur un choix change de page -->\n        <div\n          ref=\"dropdown\"\n          class=\"dropdown\"\n          @pointerenter=\"onEnter\"\n          @pointerleave=\"onLeave\"\n          @focusout=\"onFocusOut\"\n          @keydown.esc=\"open = false\"\n        >\n          <button\n            type=\"button\"\n            class=\"nav-link dropdown-toggle\"\n            :class=\"{ active: dataActive }\"\n            aria-haspopup=\"true\"\n            :aria-expanded=\"open\"\n            @click=\"onToggle\"\n          >\n            Data <span class=\"chevron\" :class=\"{ up: open }\">▾</span>\n          </button>\n\n          <transition name=\"menu\">\n            <ul v-show=\"open\" class=\"dropdown-menu\">\n              <li>\n                <router-link to=\"/animals\" class=\"dropdown-item\">\n                  <span class=\"item-icon\">🦁</span>\n                  <span class=\"item-text\">\n                    <strong>Animals</strong>\n                    <small>{{ animalCount }} residents</small>\n                  </span>\n                </router-link>\n              </li>\n              <li>\n                <router-link to=\"/zones\" class=\"dropdown-item\">\n                  <span class=\"item-icon\">🗺️</span>\n                  <span class=\"item-text\">\n                    <strong>Zones</strong>\n                    <small>{{ zoneCount }} habitats</small>\n                  </span>\n                </router-link>\n              </li>\n            </ul>\n          </transition>\n        </div>\n\n        <router-link to=\"/#activites\" class=\"nav-link\" active-class=\"\" exact-active-class=\"\">Experiences</router-link>\n        <router-link to=\"/#tarifs\" class=\"nav-link\" active-class=\"\" exact-active-class=\"\">Tickets</router-link>\n      </nav>\n\n      <div class=\"boutons-nav\">\n        <a href=\"#\" class=\"bouton-moncompte\" @click.prevent>My Account</a>\n        <router-link to=\"/#tarifs\" class=\"bouton-reserver\" active-class=\"\" exact-active-class=\"\">Book Now</router-link>\n      </div>\n    </div>\n  </header>\n</template>\n\n<script>\nimport animals from '@/assets/ANIMAL.json'\nimport zones from '@/assets/ZONE.json'\n\nexport default {\n  name: 'NavBar',\n\n  data() {\n    return {\n      open: false,\n      closeTimer: null,\n      lastPointer: ''\n    }\n  },\n\n  computed: {\n    animalCount() {\n      return animals.length\n    },\n    zoneCount() {\n      return zones.length\n    },\n    // \"Data\" est surligné quand on est sur /animals ou /zones\n    dataActive() {\n      return ['/animals', '/zones'].includes(this.$route.path)\n    }\n  },\n\n  watch: {\n    // On referme le menu à chaque changement de page\n    '$route'() {\n      this.open = false\n    }\n  },\n\n  mounted() {\n    document.addEventListener('click', this.onDocumentClick)\n  },\n\n  beforeUnmount() {\n    document.removeEventListener('click', this.onDocumentClick)\n    clearTimeout(this.closeTimer)\n  },\n\n  methods: {\n    onEnter(event) {\n      this.lastPointer = event.pointerType\n      if (event.pointerType === 'mouse') {\n        clearTimeout(this.closeTimer)\n        this.open = true\n      }\n    },\n    onLeave(event) {\n      if (event.pointerType === 'mouse') {\n        // petit délai pour ne pas fermer si le curseur dévie un instant\n        this.closeTimer = setTimeout(() => {\n          this.open = false\n        }, 150)\n      }\n    },\n    onToggle() {\n      // Souris : le survol l'a déjà ouvert, un clic ne doit pas le refermer\n      if (this.lastPointer === 'mouse') {\n        this.open = true\n      } else {\n        this.open = !this.open\n      }\n    },\n    onFocusOut(event) {\n      const next = event.relatedTarget\n      if (next && !this.$refs.dropdown.contains(next)) {\n        this.open = false\n      }\n    },\n    onDocumentClick(event) {\n      if (this.$refs.dropdown && !this.$refs.dropdown.contains(event.target)) {\n        this.open = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.container {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 0 15px;\n}\n\n.menu-haut {\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  background-color: #ffffff;\n  border-bottom: 1px solid #e2ece9;\n  padding: 18px 0;\n  font-family: Arial, sans-serif;\n}\n\n.conteneur-nav {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.mon-logo {\n  font-size: 1.8rem;\n  font-weight: bold;\n  color: #1e3a2b;\n  text-decoration: none;\n}\n\n.mon-logo span {\n  color: #d97706;\n}\n\n.liens-nav {\n  display: flex;\n  align-items: center;\n  gap: 25px;\n}\n\n.nav-link {\n  color: #1c2421;\n  font-weight: bold;\n  font-size: 1rem;\n  text-decoration: none;\n  padding: 6px 0;\n  border-bottom: 2px solid transparent;\n  transition: color 0.2s, border-color 0.2s;\n}\n\n.nav-link:hover {\n  color: #2d6a4f;\n}\n\n.nav-link.router-link-exact-active,\n.nav-link.active {\n  color: #2d6a4f;\n  border-bottom-color: #d97706;\n}\n\n/* Le bouton \"Data\" doit ressembler aux autres liens */\n.dropdown-toggle {\n  background: none;\n  border-top: none;\n  border-left: none;\n  border-right: none;\n  font-family: inherit;\n  cursor: pointer;\n}\n\n.chevron {\n  display: inline-block;\n  font-size: 0.8rem;\n  transition: transform 0.2s;\n}\n\n.chevron.up {\n  transform: rotate(180deg);\n}\n\n/* ---------- Menu déroulant ---------- */\n\n.dropdown {\n  position: relative;\n}\n\n.dropdown-menu {\n  position: absolute;\n  top: calc(100% + 8px);\n  left: 0;\n  min-width: 220px;\n  margin: 0;\n  padding: 8px;\n  list-style: none;\n  background: #ffffff;\n  border: 1px solid #e2ece9;\n  border-radius: 12px;\n  box-shadow: 0 12px 30px rgba(30, 58, 43, 0.15);\n}\n\n/* zone invisible qui comble l'espace entre le bouton et le menu */\n.dropdown-menu::before {\n  content: '';\n  position: absolute;\n  top: -10px;\n  left: 0;\n  right: 0;\n  height: 10px;\n}\n\n.dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 12px;\n  border-radius: 8px;\n  color: #1c2421;\n  text-decoration: none;\n  transition: background-color 0.15s;\n}\n\n.dropdown-item:hover,\n.dropdown-item:focus-visible {\n  background-color: #f3f7f1;\n}\n\n.dropdown-item.router-link-exact-active {\n  background-color: #e6f0e8;\n}\n\n.item-icon {\n  font-size: 1.4rem;\n}\n\n.item-text strong {\n  display: block;\n  color: #1e3a2b;\n}\n\n.item-text small {\n  color: #68756d;\n}\n\n.menu-enter-active,\n.menu-leave-active {\n  transition: opacity 0.15s ease;\n}\n\n.menu-enter-from,\n.menu-leave-to {\n  opacity: 0;\n}\n\n/* ---------- Boutons à droite ---------- */\n\n.boutons-nav {\n  display: flex;\n  gap: 10px;\n}\n\n.bouton-moncompte,\n.bouton-reserver {\n  display: inline-block;\n  padding: 12px 22px;\n  font-size: 0.95rem;\n  font-weight: bold;\n  border-radius: 6px;\n  border: 2px solid transparent;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  transition: all 0.2s ease-in-out;\n}\n\n.bouton-moncompte {\n  border-color: #2d6a4f;\n  color: #2d6a4f;\n}\n\n.bouton-moncompte:hover {\n  background-color: #2d6a4f;\n  color: #ffffff;\n}\n\n.bouton-reserver {\n  background-color: #d97706;\n  color: #ffffff;\n}\n\n.bouton-reserver:hover {\n  background-color: #b45309;\n}\n\n:focus-visible {\n  outline: 3px solid #d97706;\n  outline-offset: 2px;\n}\n\n@media (max-width: 900px) {\n  .conteneur-nav {\n    flex-direction: column;\n    gap: 15px;\n  }\n\n  .liens-nav {\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 18px;\n  }\n\n  .dropdown-menu {\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .menu-enter-active,\n  .menu-leave-active,\n  .chevron {\n    transition: none;\n  }\n}\n</style>"],"mappings":";AAiEA,OAAOA,OAAM,MAAO,sBAAqB;AACzC,OAAOC,KAAI,MAAO,oBAAmB;AAErC,eAAe;EACbC,IAAI,EAAE,QAAQ;EAEdC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,KAAK;MACXC,UAAU,EAAE,IAAI;MAChBC,WAAW,EAAE;IACf;EACF,CAAC;EAEDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,OAAOR,OAAO,CAACS,MAAK;IACtB,CAAC;IACDC,SAASA,CAAA,EAAG;MACV,OAAOT,KAAK,CAACQ,MAAK;IACpB,CAAC;IACD;IACAE,UAAUA,CAAA,EAAG;MACX,OAAO,CAAC,UAAU,EAAE,QAAQ,CAAC,CAACC,QAAQ,CAAC,IAAI,CAACC,MAAM,CAACC,IAAI;IACzD;EACF,CAAC;EAEDC,KAAK,EAAE;IACL;IACA,QAAQF,CAAA,EAAG;MACT,IAAI,CAACT,IAAG,GAAI,KAAI;IAClB;EACF,CAAC;EAEDY,OAAOA,CAAA,EAAG;IACRC,QAAQ,CAACC,gBAAgB,CAAC,OAAO,EAAE,IAAI,CAACC,eAAe;EACzD,CAAC;EAEDC,aAAaA,CAAA,EAAG;IACdH,QAAQ,CAACI,mBAAmB,CAAC,OAAO,EAAE,IAAI,CAACF,eAAe;IAC1DG,YAAY,CAAC,IAAI,CAACjB,UAAU;EAC9B,CAAC;EAEDkB,OAAO,EAAE;IACPC,OAAOA,CAACC,KAAK,EAAE;MACb,IAAI,CAACnB,WAAU,GAAImB,KAAK,CAACC,WAAU;MACnC,IAAID,KAAK,CAACC,WAAU,KAAM,OAAO,EAAE;QACjCJ,YAAY,CAAC,IAAI,CAACjB,UAAU;QAC5B,IAAI,CAACD,IAAG,GAAI,IAAG;MACjB;IACF,CAAC;IACDuB,OAAOA,CAACF,KAAK,EAAE;MACb,IAAIA,KAAK,CAACC,WAAU,KAAM,OAAO,EAAE;QACjC;QACA,IAAI,CAACrB,UAAS,GAAIuB,UAAU,CAAC,MAAM;UACjC,IAAI,CAACxB,IAAG,GAAI,KAAI;QAClB,CAAC,EAAE,GAAG;MACR;IACF,CAAC;IACDyB,QAAQA,CAAA,EAAG;MACT;MACA,IAAI,IAAI,CAACvB,WAAU,KAAM,OAAO,EAAE;QAChC,IAAI,CAACF,IAAG,GAAI,IAAG;MACjB,OAAO;QACL,IAAI,CAACA,IAAG,GAAI,CAAC,IAAI,CAACA,IAAG;MACvB;IACF,CAAC;IACD0B,UA