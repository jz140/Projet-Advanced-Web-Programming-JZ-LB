{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport { ticketTypes } from '@/data/tickets';\nimport { experiences } from '@/data/experiences';\nimport PageHeader from '@/components/PageHeader.vue';\nimport TicketStub from '@/components/TicketStub.vue';\nconst MAX_QTY = 20;\nexport default {\n  name: 'TicketsPage',\n  components: {\n    PageHeader,\n    TicketStub\n  },\n  data() {\n    const qty = {};\n    ticketTypes.forEach(t => {\n      qty[t.id] = 0;\n    });\n    const expQty = {};\n    experiences.forEach(e => {\n      expQty[e.id] = 0;\n    });\n    return {\n      tickets: ticketTypes,\n      experiences,\n      qty,\n      expQty,\n      date: new Date().toISOString().slice(0, 10),\n      today: new Date().toISOString().slice(0, 10),\n      booked: false,\n      reference: ''\n    };\n  },\n  created() {\n    // Arrivée depuis \"Book this experience\" : l'expérience est déjà ajoutée\n    const id = this.$route.query.experience;\n    if (id && id in this.expQty) {\n      this.expQty[id] = 1;\n    }\n  },\n  computed: {\n    ticketLines() {\n      return this.tickets.filter(t => this.qty[t.id] > 0).map(t => ({\n        id: t.id,\n        label: t.name,\n        qty: this.qty[t.id],\n        total: this.qty[t.id] * t.price\n      }));\n    },\n    expLines() {\n      return this.experiences.filter(e => this.expQty[e.id] > 0).map(e => ({\n        id: e.id,\n        label: e.title,\n        qty: this.expQty[e.id],\n        total: this.expQty[e.id] * e.price\n      }));\n    },\n    ticketCount() {\n      return Object.values(this.qty).reduce((a, b) => a + b, 0);\n    },\n    total() {\n      return [...this.ticketLines, ...this.expLines].reduce((sum, l) => sum + l.total, 0);\n    },\n    // Économie réalisée avec le Family Pass (2 adultes + 2 enfants)\n    savings() {\n      const adult = this.tickets.find(t => t.id === 'adult');\n      const child = this.tickets.find(t => t.id === 'child');\n      const family = this.tickets.find(t => t.id === 'family');\n      return this.qty.family * (2 * adult.price + 2 * child.price - family.price);\n    },\n    canBook() {\n      return this.ticketCount > 0 && !!this.date;\n    }\n  },\n  methods: {\n    change(group, id, delta) {\n      const store = group === 'ticket' ? this.qty : this.expQty;\n      store[id] = Math.min(MAX_QTY, Math.max(0, store[id] + delta));\n    },\n    // Pas de paiement ni de serveur pour l'instant : on affiche juste la confirmation.\n    book() {\n      if (!this.canBook) return;\n      this.reference = 'HZ-' + Math.floor(100000 + Math.random() * 900000);\n      this.booked = true;\n    },\n    reset() {\n      Object.keys(this.qty).forEach(k => {\n        this.qty[k] = 0;\n      });\n      Object.keys(this.expQty).forEach(k => {\n        this.expQty[k] = 0;\n      });\n      this.booked = false;\n    },\n    formatDate(value) {\n      return new Date(value + 'T12:00:00').toLocaleDateString('en-GB', {\n        weekday: 'long',\n        day: 'numeric',\n        month: 'long',\n        year: 'numeric'\n      });\n    }\n  }\n};","map":{"version":3,"names":["ticketTypes","experiences","PageHeader","TicketStub","MAX_QTY","name","components","data","qty","forEach","t","id","expQty","e","tickets","date","Date","toISOString","slice","today","booked","reference","created","$route","query","experience","computed","ticketLines","filter","map","label","total","price","expLines","title","ticketCount","Object","values","reduce","a","b","sum","l","savings","adult","find","child","family","canBook","methods","change","group","delta","store","Math","min","max","book","floor","random","reset","keys","k","formatDate","value","toLocaleDateString","weekday","day","month","year"],"sources":["/Users/jackyzhang/webapp_clientside/src/views/TicketsPage.vue"],"sourcesContent":["<script>\nimport { ticketTypes } from '@/data/tickets'\nimport { experiences } from '@/data/experiences'\nimport PageHeader from '@/components/PageHeader.vue'\nimport TicketStub from '@/components/TicketStub.vue'\n\nconst MAX_QTY = 20\n\nexport default {\n  name: 'TicketsPage',\n\n  components: { PageHeader, TicketStub },\n\n  data() {\n    const qty = {}\n    ticketTypes.forEach(t => { qty[t.id] = 0 })\n\n    const expQty = {}\n    experiences.forEach(e => { expQty[e.id] = 0 })\n\n    return {\n      tickets: ticketTypes,\n      experiences,\n      qty,\n      expQty,\n      date: new Date().toISOString().slice(0, 10),\n      today: new Date().toISOString().slice(0, 10),\n      booked: false,\n      reference: ''\n    }\n  },\n\n  created() {\n    // Arrivée depuis \"Book this experience\" : l'expérience est déjà ajoutée\n    const id = this.$route.query.experience\n    if (id && id in this.expQty) {\n      this.expQty[id] = 1\n    }\n  },\n\n  computed: {\n    ticketLines() {\n      return this.tickets\n        .filter(t => this.qty[t.id] > 0)\n        .map(t => ({ id: t.id, label: t.name, qty: this.qty[t.id], total: this.qty[t.id] * t.price }))\n    },\n\n    expLines() {\n      return this.experiences\n        .filter(e => this.expQty[e.id] > 0)\n        .map(e => ({ id: e.id, label: e.title, qty: this.expQty[e.id], total: this.expQty[e.id] * e.price }))\n    },\n\n    ticketCount() {\n      return Object.values(this.qty).reduce((a, b) => a + b, 0)\n    },\n\n    total() {\n      return [...this.ticketLines, ...this.expLines].reduce((sum, l) => sum + l.total, 0)\n    },\n\n    // Économie réalisée avec le Family Pass (2 adultes + 2 enfants)\n    savings() {\n      const adult = this.tickets.find(t => t.id === 'adult')\n      const child = this.tickets.find(t => t.id === 'child')\n      const family = this.tickets.find(t => t.id === 'family')\n      return this.qty.family * (2 * adult.price + 2 * child.price - family.price)\n    },\n\n    canBook() {\n      return this.ticketCount > 0 && !!this.date\n    }\n  },\n\n  methods: {\n    change(group, id, delta) {\n      const store = group === 'ticket' ? this.qty : this.expQty\n      store[id] = Math.min(MAX_QTY, Math.max(0, store[id] + delta))\n    },\n\n    // Pas de paiement ni de serveur pour l'instant : on affiche juste la confirmation.\n    book() {\n      if (!this.canBook) return\n      this.reference = 'HZ-' + Math.floor(100000 + Math.random() * 900000)\n      this.booked = true\n    },\n\n    reset() {\n      Object.keys(this.qty).forEach(k => { this.qty[k] = 0 })\n      Object.keys(this.expQty).forEach(k => { this.expQty[k] = 0 })\n      this.booked = false\n    },\n\n    formatDate(value) {\n      return new Date(value + 'T12:00:00').toLocaleDateString('en-GB', {\n        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'\n      })\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"tickets-page\">\n\n    <PageHeader\n      title=\"Tickets\"\n      lead=\"Choose your date and your tickets. Buying in advance means no waiting at the entrance.\"\n      icon=\"🎟️\"\n    />\n\n    <div class=\"container layout\">\n\n      <!-- Colonne de gauche : choix -->\n      <div class=\"choices\">\n\n        <section class=\"block\">\n          <h2>1. Pick a date</h2>\n          <label class=\"date-field\">\n            <span>Day of your visit</span>\n            <input v-model=\"date\" type=\"date\" :min=\"today\">\n          </label>\n        </section>\n\n        <section class=\"block\">\n          <h2>2. Choose your tickets</h2>\n          <div class=\"stubs\">\n            <TicketStub v-for=\"ticket in tickets\" :key=\"ticket.id\" :ticket=\"ticket\">\n              <div class=\"stepper\">\n                <button\n                  type=\"button\"\n                  :aria-label=\"'Remove one ' + ticket.name\"\n                  :disabled=\"qty[ticket.id] === 0\"\n                  @click=\"change('ticket', ticket.id, -1)\"\n                >−</button>\n                <output>{{ qty[ticket.id] }}</output>\n                <button\n                  type=\"button\"\n                  :aria-label=\"'Add one ' + ticket.name\"\n                  @click=\"change('ticket', ticket.id, 1)\"\n                >+</button>\n              </div>\n            </TicketStub>\n          </div>\n        </section>\n\n        <section class=\"block\">\n          <h2>3. Add an experience <small>(optional)</small></h2>\n          <ul class=\"exp-list\">\n            <li v-for=\"exp in experiences\" :key=\"exp.id\" class=\"exp-row\" :class=\"{ on: expQty[exp.id] > 0 }\">\n              <div class=\"exp-text\">\n                <strong>{{ exp.title }}</strong>\n                <small>{{ exp.duration }} · from {{ exp.minAge }} years old · {{ exp.price }}€ per person</small>\n              </div>\n              <div class=\"stepper\">\n                <button\n                  type=\"button\"\n                  :aria-label=\"'Remove one ' + exp.title\"\n                  :disabled=\"expQty[exp.id] === 0\"\n                  @click=\"change('exp', exp.id, -1)\"\n                >−</button>\n                <output>{{ expQty[exp.id] }}</output>\n                <button\n                  type=\"button\"\n                  :aria-label=\"'Add one ' + exp.title\"\n                  @click=\"change('exp', exp.id, 1)\"\n                >+</button>\n              </div>\n            </li>\n          </ul>\n        </section>\n\n      </div>\n\n      <!-- Colonne de droite : récapitulatif -->\n      <aside class=\"summary\">\n\n        <template v-if=\"!booked\">\n          <h2>Your visit</h2>\n\n          <p v-if=\"!ticketLines.length && !expLines.length\" class=\"hint\">\n            Add at least one ticket to start your booking.\n          </p>\n\n          <ul v-else class=\"lines\">\n            <li v-for=\"line in ticketLines\" :key=\"line.id\">\n              <span>{{ line.qty }} × {{ line.label }}</span>\n              <strong>{{ line.total }}€</strong>\n            </li>\n            <li v-for=\"line in expLines\" :key=\"line.id\">\n              <span>{{ line.qty }} × {{ line.label }}</span>\n              <strong>{{ line.total }}€</strong>\n            </li>\n          </ul>\n\n          <p v-if=\"savings > 0\" class=\"savings\">🎉 Family Pass: you save {{ savings }}€</p>\n\n          <p v-if=\"ticketLines.length && date\" class=\"when\">📅 {{ formatDate(date) }}</p>\n\n          <div class=\"total\">\n            <span>Total</span>\n            <strong>{{ total }}€</strong>\n          </div>\n\n          <button type=\"button\" class=\"btn btn-orange full\" :disabled=\"!canBook\" @click=\"book\">\n            Book now\n          </button>\n\n          <p v-if=\"expLines.length && !ticketCount\" class=\"hint warn\">\n            An experience needs at least one entrance ticket.\n          </p>\n        </template>\n\n        <!-- Confirmation -->\n        <template v-else>\n          <h2>Booking ready 🎉</h2>\n          <p class=\"when\">Reference <strong>{{ reference }}</strong></p>\n          <p class=\"when\">📅 {{ formatDate(date) }}</p>\n\n          <ul class=\"lines\">\n            <li v-for=\"line in ticketLines\" :key=\"line.id\">\n              <span>{{ line.qty }} × {{ line.label }}</span>\n              <strong>{{ line.total }}€</strong>\n            </li>\n            <li v-for=\"line in expLines\" :key=\"line.id\">\n              <span>{{ line.qty }} × {{ line.label }}</span>\n              <strong>{{ line.total }}€</strong>\n            </li>\n          </ul>\n\n          <div class=\"total\">\n            <span>Total</span>\n            <strong>{{ total }}€</strong>\n          </div>\n\n          <button type=\"button\" class=\"btn btn-outline full\" @click=\"reset\">New booking</button>\n          <router-link to=\"/\" class=\"btn btn-green full\">Back to home</router-link>\n        </template>\n\n        <div class=\"open-hours\">\n          <strong>Open every day</strong>\n          <span>09:30 to 18:30, last entry at 17:00</span>\n        </div>\n\n      </aside>\n\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.tickets-page {\n  min-height: 100vh;\n  padding-bottom: 60px;\n  background: var(--meadow);\n  --notch: var(--meadow);\n}\n\n.layout {\n  display: grid;\n  grid-template-columns: 1fr 340px;\n  gap: 36px;\n  align-items: start;\n  padding-top: 44px;\n}\n\n.block {\n  margin-bottom: 42px;\n}\n\n.block h2 {\n  margin-bottom: 18px;\n  color: var(--forest);\n  font-size: 1.5rem;\n}\n\n.block h2 small {\n  color: var(--muted);\n  font-family: var(--font-body);\n  font-size: 0.9rem;\n  font-weight: 400;\n}\n\n/* Date */\n\n.date-field {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 6px;\n  color: var(--muted);\n  font-weight: 700;\n  font-size: 0.9rem;\n}\n\n.date-field input {\n  padding: 12px 18px;\n  border: 2px solid var(--line);\n  border-radius: 999px;\n  background: #fff;\n  color: var(--forest);\n  font-family: var(--font-body);\n  font-size: 1rem;\n}\n\n/* Billets */\n\n.stubs {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n  gap: 26px;\n}\n\n/* Boutons + / - */\n\n.stepper {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.stepper button {\n  width: 34px;\n  height: 34px;\n  border: 2px solid var(--green);\n  border-radius: 50%;\n  background: #fff;\n  color: var(--green);\n  font-size: 1.2rem;\n  font-weight: 700;\n  line-height: 1;\n  cursor: pointer;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.stepper button:hover:not(:disabled) {\n  background: var(--green);\n  color: #fff;\n}\n\n.stepper button:disabled {\n  opacity: 0.35;\n  cursor: not-allowed;\n}\n\n.stepper output {\n  min-width: 22px;\n  text-align: center;\n  font-family: var(--font-display);\n  font-size: 1.2rem;\n  font-weight: 700;\n  color: var(--forest);\n}\n\n/* Expériences */\n\n.exp-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.exp-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 16px 20px;\n  background: #fff;\n  border-radius: 20px 5px 20px 5px;\n  box-shadow: var(--shadow);\n}\n\n.exp-row.on {\n  box-shadow: 0 0 0 2px var(--green), var(--shadow);\n}\n\n.exp-text strong {\n  display: block;\n  color: var(--forest);\n}\n\n.exp-text small {\n  color: var(--muted);\n}\n\n/* Récapitulatif */\n\n.summary {\n  position: sticky;\n  top: 90px;\n  padding: 28px;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n}\n\n.summary h2 {\n  margin-bottom: 16px;\n  color: var(--forest);\n  font-size: 1.5rem;\n}\n\n.hint {\n  color: var(--muted);\n  font-size: 0.93rem;\n}\n\n.hint.warn {\n  margin-top: 12px;\n  color: var(--orange-dark);\n  font-weight: 700;\n}\n\n.lines {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.lines li {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 9px 0;\n  border-bottom: 1px solid var(--line);\n  font-size: 0.93rem;\n}\n\n.savings {\n  margin-top: 12px;\n  padding: 8px 14px;\n  border-radius: 12px;\n  background: var(--mint);\n  color: var(--forest);\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.when {\n  margin-top: 12px;\n  color: var(--muted);\n  font-size: 0.93rem;\n}\n\n.total {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  margin: 18px 0;\n  font-weight: 700;\n}\n\n.total strong {\n  color: var(--orange);\n  font-family: var(--font-display);\n  font-size: 2.2rem;\n}\n\n.full {\n  width: 100%;\n  margin-top: 10px;\n}\n\n.open-hours {\n  margin-top: 22px;\n  padding-top: 16px;\n  border-top: 2px dashed var(--line);\n  color: var(--muted);\n  font-size: 0.88rem;\n}\n\n.open-hours strong {\n  display: block;\n  color: var(--forest);\n}\n\n@media (max-width: 960px) {\n  .layout {\n    grid-template-columns: 1fr;\n  }\n\n  .summary {\n    position: static;\n  }\n}\n\n@media (max-width: 520px) {\n  .exp-row {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}\n</style>"],"mappings":";;;;;;AACA,SAASA,WAAU,QAAS,gBAAe;AAC3C,SAASC,WAAU,QAAS,oBAAmB;AAC/C,OAAOC,UAAS,MAAO,6BAA4B;AACnD,OAAOC,UAAS,MAAO,6BAA4B;AAEnD,MAAMC,OAAM,GAAI,EAAC;AAEjB,eAAe;EACbC,IAAI,EAAE,aAAa;EAEnBC,UAAU,EAAE;IAAEJ,UAAU;IAAEC;EAAW,CAAC;EAEtCI,IAAIA,CAAA,EAAG;IACL,MAAMC,GAAE,GAAI,CAAC;IACbR,WAAW,CAACS,OAAO,CAACC,CAAA,IAAK;MAAEF,GAAG,CAACE,CAAC,CAACC,EAAE,IAAI;IAAE,CAAC;IAE1C,MAAMC,MAAK,GAAI,CAAC;IAChBX,WAAW,CAACQ,OAAO,CAACI,CAAA,IAAK;MAAED,MAAM,CAACC,CAAC,CAACF,EAAE,IAAI;IAAE,CAAC;IAE7C,OAAO;MACLG,OAAO,EAAEd,WAAW;MACpBC,WAAW;MACXO,GAAG;MACHI,MAAM;MACNG,IAAI,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,CAAC;MAC3CC,KAAK,EAAE,IAAIH,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,CAAC;MAC5CE,MAAM,EAAE,KAAK;MACbC,SAAS,EAAE;IACb;EACF,CAAC;EAEDC,OAAOA,CAAA,EAAG;IACR;IACA,MAAMX,EAAC,GAAI,IAAI,CAACY,MAAM,CAACC,KAAK,CAACC,UAAS;IACtC,IAAId,EAAC,IAAKA,EAAC,IAAK,IAAI,CAACC,MAAM,EAAE;MAC3B,IAAI,CAACA,MAAM,CAACD,EAAE,IAAI;IACpB;EACF,CAAC;EAEDe,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,OAAO,IAAI,CAACb,OAAM,CACfc,MAAM,CAAClB,CAAA,IAAK,IAAI,CAACF,GAAG,CAACE,CAAC,CAACC,EAAE,IAAI,CAAC,EAC9BkB,GAAG,CAACnB,CAAA,KAAM;QAAEC,EAAE,EAAED,CAAC,CAACC,EAAE;QAAEmB,KAAK,EAAEpB,CAAC,CAACL,IAAI;QAAEG,GAAG,EAAE,IAAI,CAACA,GAAG,CAACE,CAAC,CAACC,EAAE,CAAC;QAAEoB,KAAK,EAAE,IAAI,CAACvB,GAAG,CAACE,CAAC,CAACC,EAAE,IAAID,CAAC,CAACsB;MAAM,CAAC,CAAC;IACjG,CAAC;IAEDC,QAAQA,CAAA,EAAG;MACT,OAAO,IAAI,CAAChC,WAAU,CACnB2B,MAAM,CAACf,CAAA,IAAK,IAAI,CAACD,MAAM,CAACC,CAAC,CAACF,EAAE,IAAI,CAAC,EACjCkB,GAAG,CAAChB,CAAA,KAAM;QAAEF,EAAE,EAAEE,CAAC,CAACF,EAAE;QAAEmB,KAAK,EAAEjB,CAAC,CAACqB,KAAK;QAAE1B,GAAG,EAAE,IAAI,CAACI,MAAM,CAACC,CAAC,CAACF,EAAE,CAAC;QAAEoB,KAAK,EAAE,IAAI,CAACnB,MAAM,CAACC,CAAC,CAACF,EAAE,IAAIE,CAAC,CAACmB;MAAM,CAAC,CAAC;IACxG,CAAC;IAEDG,WAAWA,CAAA,EAAG;MACZ,OAAOC,MAAM,CAA