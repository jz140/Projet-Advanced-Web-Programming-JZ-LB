{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.reduce.js\";\nimport purchases from '@/assets/TICKET.json';\nimport { getTicketTypes, cleanType } from '@/utils/ticketTypes';\nimport PageHeader from '@/components/PageHeader.vue';\nimport TicketStub from '@/components/TicketStub.vue';\nconst MAX_QTY = 20;\nexport default {\n  name: 'TicketsPage',\n  components: {\n    PageHeader,\n    TicketStub\n  },\n  data() {\n    const tickets = getTicketTypes();\n    const qty = {};\n    tickets.forEach(t => {\n      qty[t.id] = 0;\n    });\n    return {\n      tickets,\n      qty,\n      date: new Date().toISOString().slice(0, 10),\n      today: new Date().toISOString().slice(0, 10),\n      booked: false,\n      reference: ''\n    };\n  },\n  computed: {\n    lines() {\n      return this.tickets.filter(t => this.qty[t.id] > 0).map(t => ({\n        id: t.id,\n        label: t.name,\n        qty: this.qty[t.id],\n        total: this.qty[t.id] * t.price\n      }));\n    },\n    ticketCount() {\n      return Object.values(this.qty).reduce((a, b) => a + b, 0);\n    },\n    total() {\n      const sum = this.lines.reduce((acc, l) => acc + l.total, 0);\n      return Math.round(sum * 100) / 100;\n    },\n    canBook() {\n      return this.ticketCount > 0 && !!this.date;\n    },\n    // Les achats de TICKET.json, du plus récent au plus ancien\n    history() {\n      return [...purchases].sort((a, b) => b.payement_date.localeCompare(a.payement_date));\n    }\n  },\n  methods: {\n    cleanType,\n    change(id, delta) {\n      this.qty[id] = Math.min(MAX_QTY, Math.max(0, this.qty[id] + delta));\n    },\n    // Pas de paiement ni de serveur pour l'instant : on affiche juste la confirmation.\n    book() {\n      if (!this.canBook) return;\n      this.reference = 'HZ-' + Math.floor(100000 + Math.random() * 900000);\n      this.booked = true;\n    },\n    reset() {\n      Object.keys(this.qty).forEach(k => {\n        this.qty[k] = 0;\n      });\n      this.booked = false;\n    },\n    formatDate(value) {\n      return new Date(value + 'T12:00:00').toLocaleDateString('en-GB', {\n        weekday: 'long',\n        day: 'numeric',\n        month: 'long',\n        year: 'numeric'\n      });\n    },\n    formatPurchaseDate(value) {\n      return new Date(value.replace(' ', 'T')).toLocaleDateString('en-GB', {\n        day: 'numeric',\n        month: 'short',\n        year: 'numeric'\n      });\n    }\n  }\n};","map":{"version":3,"names":["purchases","getTicketTypes","cleanType","PageHeader","TicketStub","MAX_QTY","name","components","data","tickets","qty","forEach","t","id","date","Date","toISOString","slice","today","booked","reference","computed","lines","filter","map","label","total","price","ticketCount","Object","values","reduce","a","b","sum","acc","l","Math","round","canBook","history","sort","payement_date","localeCompare","methods","change","delta","min","max","book","floor","random","reset","keys","k","formatDate","value","toLocaleDateString","weekday","day","month","year","formatPurchaseDate","replace"],"sources":["/Users/laetitia/Projet-Advanced-Web-Programming-JZ-LB/webapp_clientside/src/views/TicketsPage.vue"],"sourcesContent":["<script>\nimport purchases from '@/assets/TICKET.json'\nimport { getTicketTypes, cleanType } from '@/utils/ticketTypes'\nimport PageHeader from '@/components/PageHeader.vue'\nimport TicketStub from '@/components/TicketStub.vue'\n\nconst MAX_QTY = 20\n\nexport default {\n  name: 'TicketsPage',\n\n  components: { PageHeader, TicketStub },\n\n  data() {\n    const tickets = getTicketTypes()\n\n    const qty = {}\n    tickets.forEach(t => { qty[t.id] = 0 })\n\n    return {\n      tickets,\n      qty,\n      date: new Date().toISOString().slice(0, 10),\n      today: new Date().toISOString().slice(0, 10),\n      booked: false,\n      reference: ''\n    }\n  },\n\n  computed: {\n    lines() {\n      return this.tickets\n        .filter(t => this.qty[t.id] > 0)\n        .map(t => ({ id: t.id, label: t.name, qty: this.qty[t.id], total: this.qty[t.id] * t.price }))\n    },\n\n    ticketCount() {\n      return Object.values(this.qty).reduce((a, b) => a + b, 0)\n    },\n\n    total() {\n      const sum = this.lines.reduce((acc, l) => acc + l.total, 0)\n      return Math.round(sum * 100) / 100\n    },\n\n    canBook() {\n      return this.ticketCount > 0 && !!this.date\n    },\n\n    // Les achats de TICKET.json, du plus récent au plus ancien\n    history() {\n      return [...purchases].sort((a, b) => b.payement_date.localeCompare(a.payement_date))\n    }\n  },\n\n  methods: {\n    cleanType,\n\n    change(id, delta) {\n      this.qty[id] = Math.min(MAX_QTY, Math.max(0, this.qty[id] + delta))\n    },\n\n    // Pas de paiement ni de serveur pour l'instant : on affiche juste la confirmation.\n    book() {\n      if (!this.canBook) return\n      this.reference = 'HZ-' + Math.floor(100000 + Math.random() * 900000)\n      this.booked = true\n    },\n\n    reset() {\n      Object.keys(this.qty).forEach(k => { this.qty[k] = 0 })\n      this.booked = false\n    },\n\n    formatDate(value) {\n      return new Date(value + 'T12:00:00').toLocaleDateString('en-GB', {\n        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'\n      })\n    },\n\n    formatPurchaseDate(value) {\n      return new Date(value.replace(' ', 'T')).toLocaleDateString('en-GB', {\n        day: 'numeric', month: 'short', year: 'numeric'\n      })\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"tickets-page\">\n\n    <PageHeader\n      title=\"Tickets\"\n      lead=\"Choose your date and your tickets. Buying in advance means no waiting at the entrance.\"\n      icon=\"🎟️\"\n    />\n\n    <div class=\"container layout\">\n\n      <!-- Colonne de gauche : choix -->\n      <div class=\"choices\">\n\n        <section class=\"block\">\n          <h2>1. Pick a date</h2>\n          <label class=\"date-field\">\n            <span>Day of your visit</span>\n            <input v-model=\"date\" type=\"date\" :min=\"today\">\n          </label>\n        </section>\n\n        <section class=\"block\">\n          <h2>2. Choose your tickets</h2>\n          <div class=\"stubs\">\n            <TicketStub v-for=\"ticket in tickets\" :key=\"ticket.id\" :ticket=\"ticket\">\n              <div class=\"stepper\">\n                <button\n                  type=\"button\"\n                  :aria-label=\"'Remove one ' + ticket.name\"\n                  :disabled=\"qty[ticket.id] === 0\"\n                  @click=\"change(ticket.id, -1)\"\n                >−</button>\n                <output>{{ qty[ticket.id] }}</output>\n                <button\n                  type=\"button\"\n                  :aria-label=\"'Add one ' + ticket.name\"\n                  @click=\"change(ticket.id, 1)\"\n                >+</button>\n              </div>\n            </TicketStub>\n          </div>\n        </section>\n\n        <!-- Historique : vient de TICKET.json -->\n        <section class=\"block\">\n          <h2>Recent purchases</h2>\n          <ul class=\"history\">\n            <li v-for=\"p in history\" :key=\"p.id_ticket\" class=\"history-row\">\n              <div class=\"history-main\">\n                <strong>{{ p.quantity_ticket }} × {{ cleanType(p.ticket_type) }}</strong>\n                <small>{{ formatPurchaseDate(p.payement_date) }} · {{ p.payement_method }}</small>\n              </div>\n              <span class=\"history-amount\">{{ p.total_amount }}€</span>\n            </li>\n          </ul>\n        </section>\n\n      </div>\n\n      <!-- Colonne de droite : récapitulatif -->\n      <aside class=\"summary\">\n\n        <template v-if=\"!booked\">\n          <h2>Your visit</h2>\n\n          <p v-if=\"!lines.length\" class=\"hint\">\n            Add at least one ticket to start your booking.\n          </p>\n\n          <ul v-else class=\"lines\">\n            <li v-for=\"line in lines\" :key=\"line.id\">\n              <span>{{ line.qty }} × {{ line.label }}</span>\n              <strong>{{ line.total }}€</strong>\n            </li>\n          </ul>\n\n          <p v-if=\"lines.length && date\" class=\"when\">📅 {{ formatDate(date) }}</p>\n\n          <div class=\"total\">\n            <span>Total</span>\n            <strong>{{ total }}€</strong>\n          </div>\n\n          <button type=\"button\" class=\"btn btn-orange full\" :disabled=\"!canBook\" @click=\"book\">\n            Book now\n          </button>\n        </template>\n\n        <!-- Confirmation -->\n        <template v-else>\n          <h2>Booking ready 🎉</h2>\n          <p class=\"when\">Reference <strong>{{ reference }}</strong></p>\n          <p class=\"when\">📅 {{ formatDate(date) }}</p>\n\n          <ul class=\"lines\">\n            <li v-for=\"line in lines\" :key=\"line.id\">\n              <span>{{ line.qty }} × {{ line.label }}</span>\n              <strong>{{ line.total }}€</strong>\n            </li>\n          </ul>\n\n          <div class=\"total\">\n            <span>Total</span>\n            <strong>{{ total }}€</strong>\n          </div>\n\n          <button type=\"button\" class=\"btn btn-outline full\" @click=\"reset\">New booking</button>\n          <router-link to=\"/\" class=\"btn btn-green full\">Back to home</router-link>\n        </template>\n\n        <div class=\"open-hours\">\n          <strong>Open every day</strong>\n          <span>09:30 to 18:30, last entry at 17:00</span>\n        </div>\n\n      </aside>\n\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.tickets-page {\n  min-height: 100vh;\n  padding-bottom: 60px;\n  background: var(--meadow);\n  --notch: var(--meadow);\n}\n\n.layout {\n  display: grid;\n  grid-template-columns: 1fr 340px;\n  gap: 36px;\n  align-items: start;\n  padding-top: 44px;\n}\n\n.block {\n  margin-bottom: 42px;\n}\n\n.block h2 {\n  margin-bottom: 18px;\n  color: var(--forest);\n  font-size: 1.5rem;\n}\n\n/* Date */\n\n.date-field {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 6px;\n  color: var(--muted);\n  font-weight: 700;\n  font-size: 0.9rem;\n}\n\n.date-field input {\n  padding: 12px 18px;\n  border: 2px solid var(--line);\n  border-radius: 999px;\n  background: #fff;\n  color: var(--forest);\n  font-family: var(--font-body);\n  font-size: 1rem;\n}\n\n/* Billets */\n\n.stubs {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n  gap: 26px;\n}\n\n/* Boutons + / - */\n\n.stepper {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.stepper button {\n  width: 34px;\n  height: 34px;\n  border: 2px solid var(--green);\n  border-radius: 50%;\n  background: #fff;\n  color: var(--green);\n  font-size: 1.2rem;\n  font-weight: 700;\n  line-height: 1;\n  cursor: pointer;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.stepper button:hover:not(:disabled) {\n  background: var(--green);\n  color: #fff;\n}\n\n.stepper button:disabled {\n  opacity: 0.35;\n  cursor: not-allowed;\n}\n\n.stepper output {\n  min-width: 22px;\n  text-align: center;\n  font-family: var(--font-display);\n  font-size: 1.2rem;\n  font-weight: 700;\n  color: var(--forest);\n}\n\n/* Historique */\n\n.history {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.history-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 14px 20px;\n  background: #fff;\n  border-radius: 20px 5px 20px 5px;\n  box-shadow: var(--shadow);\n}\n\n.history-main strong {\n  display: block;\n  color: var(--forest);\n}\n\n.history-main small {\n  color: var(--muted);\n}\n\n.history-amount {\n  color: var(--orange);\n  font-family: var(--font-display);\n  font-size: 1.2rem;\n  font-weight: 700;\n}\n\n/* Récapitulatif */\n\n.summary {\n  position: sticky;\n  top: 90px;\n  padding: 28px;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n}\n\n.summary h2 {\n  margin-bottom: 16px;\n  color: var(--forest);\n  font-size: 1.5rem;\n}\n\n.hint {\n  color: var(--muted);\n  font-size: 0.93rem;\n}\n\n.lines {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.lines li {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 9px 0;\n  border-bottom: 1px solid var(--line);\n  font-size: 0.93rem;\n}\n\n.when {\n  margin-top: 12px;\n  color: var(--muted);\n  font-size: 0.93rem;\n}\n\n.total {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  margin: 18px 0;\n  font-weight: 700;\n}\n\n.total strong {\n  color: var(--orange);\n  font-family: var(--font-display);\n  font-size: 2.2rem;\n}\n\n.full {\n  width: 100%;\n  margin-top: 10px;\n}\n\n.open-hours {\n  margin-top: 22px;\n  padding-top: 16px;\n  border-top: 2px dashed var(--line);\n  color: var(--muted);\n  font-size: 0.88rem;\n}\n\n.open-hours strong {\n  display: block;\n  color: var(--forest);\n}\n\n@media (max-width: 960px) {\n  .layout {\n    grid-template-columns: 1fr;\n  }\n\n  .summary {\n    position: static;\n  }\n}\n</style>"],"mappings":";;;;;AACA,OAAOA,SAAQ,MAAO,sBAAqB;AAC3C,SAASC,cAAc,EAAEC,SAAQ,QAAS,qBAAoB;AAC9D,OAAOC,UAAS,MAAO,6BAA4B;AACnD,OAAOC,UAAS,MAAO,6BAA4B;AAEnD,MAAMC,OAAM,GAAI,EAAC;AAEjB,eAAe;EACbC,IAAI,EAAE,aAAa;EAEnBC,UAAU,EAAE;IAAEJ,UAAU;IAAEC;EAAW,CAAC;EAEtCI,IAAIA,CAAA,EAAG;IACL,MAAMC,OAAM,GAAIR,cAAc,CAAC;IAE/B,MAAMS,GAAE,GAAI,CAAC;IACbD,OAAO,CAACE,OAAO,CAACC,CAAA,IAAK;MAAEF,GAAG,CAACE,CAAC,CAACC,EAAE,IAAI;IAAE,CAAC;IAEtC,OAAO;MACLJ,OAAO;MACPC,GAAG;MACHI,IAAI,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,CAAC;MAC3CC,KAAK,EAAE,IAAIH,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAACC,KAAK,CAAC,CAAC,EAAE,EAAE,CAAC;MAC5CE,MAAM,EAAE,KAAK;MACbC,SAAS,EAAE;IACb;EACF,CAAC;EAEDC,QAAQ,EAAE;IACRC,KAAKA,CAAA,EAAG;MACN,OAAO,IAAI,CAA