{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport zones from '@/assets/ZONE.json';\nimport animals from '@/assets/ANIMAL.json';\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle';\nimport PageHeader from '@/components/PageHeader.vue';\nexport default {\n  name: 'ZoneList',\n  components: {\n    PageHeader\n  },\n  data() {\n    return {\n      zones,\n      animals\n    };\n  },\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n    animalsOf(idZone) {\n      return this.animals.filter(animal => animal.id_zone === idZone);\n    },\n    // Affiche 4 noms d'animaux maximum, puis \"+N\"\n    previewOf(idZone) {\n      return this.animalsOf(idZone).slice(0, 4);\n    },\n    extraCount(idZone) {\n      return Math.max(this.animalsOf(idZone).length - 4, 0);\n    }\n  }\n};","map":{"version":3,"names":["zones","animals","zoneEmoji","zoneBackground","PageHeader","name","components","data","methods","animalsOf","idZone","filter","animal","id_zone","previewOf","slice","extraCount","Math","max","length"],"sources":["/Users/laetitia/Projet-Advanced-Web-Programming-JZ-LB/webapp_clientside/src/views/ZoneList.vue"],"sourcesContent":["<script>\nimport zones from '@/assets/ZONE.json'\nimport animals from '@/assets/ANIMAL.json'\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle'\nimport PageHeader from '@/components/PageHeader.vue'\n\nexport default {\n  name: 'ZoneList',\n\n  components: { PageHeader },\n\n  data() {\n    return {\n      zones,\n      animals\n    }\n  },\n\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n\n    animalsOf(idZone) {\n      return this.animals.filter(animal => animal.id_zone === idZone)\n    },\n\n    // Affiche 4 noms d'animaux maximum, puis \"+N\"\n    previewOf(idZone) {\n      return this.animalsOf(idZone).slice(0, 4)\n    },\n\n    extraCount(idZone) {\n      return Math.max(this.animalsOf(idZone).length - 4, 0)\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"zones-page\">\n\n    <PageHeader\n      title=\"HappyZoo Zones\"\n      :lead=\"zones.length + ' habitats to explore, each home to its own animals.'\"\n      icon=\"🗺️\"\n    />\n\n    <div class=\"container content\">\n\n      <div class=\"zone-list\">\n\n        <article\n          v-for=\"zone in zones\"\n          :key=\"zone.id_zone\"\n          class=\"zone-card\"\n        >\n\n          <!-- Panneau coloré -->\n          <div class=\"zone-art\" :style=\"{ background: zoneBackground(zone.id_zone) }\">\n            <span class=\"zone-emoji\" aria-hidden=\"true\">{{ zoneEmoji(zone.id_zone) }}</span>\n          </div>\n\n          <!-- Informations -->\n          <div class=\"zone-info\">\n\n            <span class=\"zone-theme\">{{ zone.theme_zone }}</span>\n            <h2>{{ zone.name_zone }}</h2>\n            <p class=\"description\">{{ zone.description_zone }}</p>\n\n            <div class=\"facts\">\n              <div class=\"fact\">\n                <small>Location</small>\n                <strong>{{ zone.place_zone }}</strong>\n              </div>\n              <div class=\"fact\">\n                <small>Height</small>\n                <strong>{{ zone.height_zone }} m</strong>\n              </div>\n              <div class=\"fact\">\n                <small>Animals</small>\n                <strong>{{ animalsOf(zone.id_zone).length }}</strong>\n              </div>\n            </div>\n\n            <div class=\"chips\">\n              <span\n                v-for=\"animal in previewOf(zone.id_zone)\"\n                :key=\"animal.id_animal\"\n                class=\"chip\"\n              >\n                {{ animal.species_animal }}\n              </span>\n              <span v-if=\"extraCount(zone.id_zone) > 0\" class=\"chip chip-more\">\n                +{{ extraCount(zone.id_zone) }}\n              </span>\n            </div>\n\n            <router-link\n              :to=\"{ path: '/animals', query: { zone: zone.id_zone } }\"\n              class=\"see-animals\"\n            >\n              See the animals →\n            </router-link>\n\n          </div>\n\n        </article>\n\n      </div>\n\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.zones-page {\n  min-height: 100vh;\n  padding-bottom: 60px;\n  background: var(--meadow);\n}\n\n.content {\n  padding-top: 44px;\n}\n\n.zone-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));\n  gap: 30px;\n}\n\n.zone-card {\n  display: grid;\n  grid-template-columns: 170px 1fr;\n  overflow: hidden;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n  transition: box-shadow 0.2s;\n}\n\n.zone-card:hover {\n  box-shadow: 0 0 0 2px var(--green), var(--shadow);\n}\n\n.zone-art {\n  display: grid;\n  place-items: center;\n}\n\n.zone-emoji {\n  font-size: 4.6rem;\n  line-height: 1;\n}\n\n.zone-info {\n  display: flex;\n  flex-direction: column;\n  padding: 24px 26px;\n}\n\n.zone-theme {\n  align-self: flex-start;\n  padding: 3px 12px;\n  border-radius: 999px;\n  background: var(--mint);\n  color: var(--forest);\n  font-size: 0.76rem;\n  font-weight: 700;\n}\n\n.zone-info h2 {\n  margin-top: 10px;\n  color: var(--forest);\n  font-size: 1.6rem;\n}\n\n.description {\n  margin-top: 6px;\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n.facts {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 10px;\n  margin-top: 18px;\n}\n\n.fact {\n  padding: 10px 8px;\n  background: var(--meadow);\n  border-radius: 14px 4px 14px 4px;\n  text-align: center;\n}\n\n.fact small {\n  display: block;\n  color: var(--muted);\n  font-size: 0.74rem;\n}\n\n.fact strong {\n  color: var(--green);\n  font-family: var(--font-display);\n  font-size: 1rem;\n}\n\n.chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 16px;\n}\n\n.chip {\n  padding: 3px 11px;\n  border-radius: 999px;\n  background: var(--sand);\n  color: var(--forest);\n  font-size: 0.8rem;\n}\n\n.chip-more {\n  background: var(--forest);\n  color: #fff;\n  font-weight: 700;\n}\n\n.see-animals {\n  align-self: flex-start;\n  margin-top: auto;\n  padding-top: 18px;\n  color: var(--orange);\n  font-weight: 700;\n}\n\n.see-animals:hover {\n  color: var(--orange-dark);\n  text-decoration: underline;\n}\n\n@media (max-width: 560px) {\n  .zone-list {\n    grid-template-columns: 1fr;\n  }\n\n  .zone-card {\n    grid-template-columns: 1fr;\n  }\n\n  .zone-art {\n    height: 120px;\n  }\n}\n</style>"],"mappings":";;AACA,OAAOA,KAAI,MAAO,oBAAmB;AACrC,OAAOC,OAAM,MAAO,sBAAqB;AACzC,SAASC,SAAS,EAAEC,cAAa,QAAS,mBAAkB;AAC5D,OAAOC,UAAS,MAAO,6BAA4B;AAEnD,eAAe;EACbC,IAAI,EAAE,UAAU;EAEhBC,UAAU,EAAE;IAAEF;EAAW,CAAC;EAE1BG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLP,KAAK;MACLC;IACF;EACF,CAAC;EAEDO,OAAO,EAAE;IACPN,SAAS;IACTC,cAAc;IAEdM,SAASA,CAACC,MAAM,EAAE;MAChB,OAAO,IAAI,CAACT,OAAO,CAACU,MAAM,CAACC,MAAK,IAAKA,MAAM,CAACC,OAAM,KAAMH,MAAM;IAChE,CAAC;IAED;IACAI,SAASA,CAACJ,MAAM,EAAE;MAChB,OAAO,IAAI,CAACD,SAAS,CAACC,MAAM,CAAC,CAACK,KAAK,CAAC,CAAC,EAAE,CAAC;IAC1C,CAAC;IAEDC,UAAUA,CAACN,MAAM,EAAE;MACjB,OAAOO,IAAI,CAACC,GAAG,CAAC,IAAI,CAACT,SAAS,CAACC,MAAM,CAAC,CAACS,MAAK,GAAI,CAAC,EAAE,CAAC;IACtD;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}