{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport animals from '@/assets/ANIMAL.json';\nimport zones from '@/assets/ZONE.json';\nimport defaultAnimal from '@/assets/animals_images/default-animal.jpg';\nimport PageHeader from '@/components/PageHeader.vue';\nexport default {\n  name: 'AnimalList',\n  components: {\n    PageHeader\n  },\n  data() {\n    return {\n      animals: animals,\n      zones: zones,\n      defaultAnimal: defaultAnimal,\n      search: ''\n    };\n  },\n  computed: {\n    // La zone choisie est stockée dans l'URL (/animals?zone=2),\n    // ce qui permet d'arriver ici depuis la page des zones déjà filtré.\n    selectedZone: {\n      get() {\n        return this.$route.query.zone ? String(this.$route.query.zone) : '';\n      },\n      set(value) {\n        this.$router.replace({\n          query: value ? {\n            zone: value\n          } : {}\n        });\n      }\n    },\n    filteredAnimals() {\n      const text = this.search.trim().toLowerCase();\n      return this.animals.filter(animal => {\n        const matchZone = !this.selectedZone || String(animal.id_zone) === this.selectedZone;\n        const matchSearch = !text || animal.species_animal.toLowerCase().includes(text) || animal.description_animal.toLowerCase().includes(text);\n        return matchZone && matchSearch;\n      });\n    },\n    hasFilter() {\n      return this.search.trim() !== '' || this.selectedZone !== '';\n    }\n  },\n  methods: {\n    getAnimalImage(animal) {\n      try {\n        return require('@/assets/animals_images/' + animal.species_animal.replaceAll(' ', '_') + '.jpg');\n      } catch (error) {\n        return this.defaultAnimal;\n      }\n    },\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone);\n      return zone ? zone.name_zone : '';\n    },\n    formatWeight(kg) {\n      if (kg < 1) return Math.round(kg * 1000) + ' g';\n      return kg.toLocaleString('en-US') + ' kg';\n    },\n    resetFilters() {\n      this.search = '';\n      this.selectedZone = '';\n    }\n  }\n};","map":{"version":3,"names":["animals","zones","defaultAnimal","PageHeader","name","components","data","search","computed","selectedZone","get","$route","query","zone","String","set","value","$router","replace","filteredAnimals","text","trim","toLowerCase","filter","animal","matchZone","id_zone","matchSearch","species_animal","includes","description_animal","hasFilter","methods","getAnimalImage","require","replaceAll","error","zoneName","idZone","find","z","name_zone","formatWeight","kg","Math","round","toLocaleString","resetFilters"],"sources":["/Users/laetitia/Projet-Advanced-Web-Programming-JZ-LB/webapp_clientside/src/views/AnimalList.vue"],"sourcesContent":["<script>\nimport animals from '@/assets/ANIMAL.json'\nimport zones from '@/assets/ZONE.json'\nimport defaultAnimal from '@/assets/animals_images/default-animal.jpg'\nimport PageHeader from '@/components/PageHeader.vue'\n\nexport default {\n  name: 'AnimalList',\n\n  components: { PageHeader },\n\n  data() {\n    return {\n      animals: animals,\n      zones: zones,\n      defaultAnimal: defaultAnimal,\n      search: ''\n    }\n  },\n\n  computed: {\n    // La zone choisie est stockée dans l'URL (/animals?zone=2),\n    // ce qui permet d'arriver ici depuis la page des zones déjà filtré.\n    selectedZone: {\n      get() {\n        return this.$route.query.zone ? String(this.$route.query.zone) : ''\n      },\n      set(value) {\n        this.$router.replace({ query: value ? { zone: value } : {} })\n      }\n    },\n\n    filteredAnimals() {\n      const text = this.search.trim().toLowerCase()\n\n      return this.animals.filter(animal => {\n        const matchZone =\n          !this.selectedZone || String(animal.id_zone) === this.selectedZone\n\n        const matchSearch =\n          !text ||\n          animal.species_animal.toLowerCase().includes(text) ||\n          animal.description_animal.toLowerCase().includes(text)\n\n        return matchZone && matchSearch\n      })\n    },\n\n    hasFilter() {\n      return this.search.trim() !== '' || this.selectedZone !== ''\n    }\n  },\n\n  methods: {\n    getAnimalImage(animal) {\n      try {\n        return require(\n          '@/assets/animals_images/' +\n          animal.species_animal.replaceAll(' ', '_') +\n          '.jpg'\n        )\n      } catch (error) {\n        return this.defaultAnimal\n      }\n    },\n\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone)\n      return zone ? zone.name_zone : ''\n    },\n\n    formatWeight(kg) {\n      if (kg < 1) return Math.round(kg * 1000) + ' g'\n      return kg.toLocaleString('en-US') + ' kg'\n    },\n\n    resetFilters() {\n      this.search = ''\n      this.selectedZone = ''\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"animals-page\">\n\n    <PageHeader\n      title=\"HappyZoo Animals\"\n      lead=\"Discover all the amazing animals living in our zoo.\"\n      icon=\"🦁\"\n    >\n      <!-- Recherche et filtre, dans la bannière -->\n      <div class=\"toolbar\">\n        <input\n          v-model=\"search\"\n          type=\"search\"\n          class=\"field search-input\"\n          placeholder=\"Search an animal...\"\n          aria-label=\"Search an animal\"\n        >\n\n        <select v-model=\"selectedZone\" class=\"field zone-select\" aria-label=\"Filter by zone\">\n          <option value=\"\">All zones</option>\n          <option\n            v-for=\"zone in zones\"\n            :key=\"zone.id_zone\"\n            :value=\"String(zone.id_zone)\"\n          >\n            {{ zone.name_zone }}\n          </option>\n        </select>\n\n        <button v-if=\"hasFilter\" type=\"button\" class=\"btn btn-light btn-sm\" @click=\"resetFilters\">\n          Reset\n        </button>\n      </div>\n    </PageHeader>\n\n    <div class=\"container content\">\n\n      <p class=\"result-count\">\n        {{ filteredAnimals.length }}\n        {{ filteredAnimals.length === 1 ? 'animal' : 'animals' }} found\n      </p>\n\n      <!-- Liste des animaux -->\n      <div v-if=\"filteredAnimals.length\" class=\"animal-list\">\n\n        <article\n          v-for=\"animal in filteredAnimals\"\n          :key=\"animal.id_animal\"\n          class=\"animal-card\"\n        >\n\n          <div class=\"animal-image\">\n            <img :src=\"getAnimalImage(animal)\" :alt=\"animal.species_animal\">\n            <span class=\"zone-badge\">{{ zoneName(animal.id_zone) }}</span>\n          </div>\n\n          <div class=\"animal-info\">\n            <h2>{{ animal.species_animal }}</h2>\n            <p class=\"description\">{{ animal.description_animal }}</p>\n\n            <!-- Mesures -->\n            <div class=\"measures\">\n              <div class=\"measure\">\n                <strong>{{ animal.length_animal }} m</strong>\n                <small>Length</small>\n              </div>\n              <div class=\"measure\">\n                <strong>{{ animal.height_animal }} m</strong>\n                <small>Height</small>\n              </div>\n              <div class=\"measure\">\n                <strong>{{ formatWeight(animal.weight_animal) }}</strong>\n                <small>Weight</small>\n              </div>\n            </div>\n\n            <div class=\"tags\">\n              <span class=\"tag\">{{ animal.gender_animal }}</span>\n              <span class=\"tag\">{{ animal.habitat_animal }}</span>\n            </div>\n          </div>\n\n        </article>\n\n      </div>\n\n      <!-- Aucun résultat -->\n      <div v-else class=\"empty\">\n        <p>😕 No animal matches your search.</p>\n        <button type=\"button\" class=\"btn btn-green\" @click=\"resetFilters\">Reset filters</button>\n      </div>\n\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.animals-page {\n  background: var(--meadow);\n  min-height: 100vh;\n  padding-bottom: 60px;\n}\n\n/* Barre d'outils dans la bannière */\n\n.toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.field {\n  padding: 12px 18px;\n  border: none;\n  border-radius: 999px;\n  background: #fff;\n  color: var(--forest);\n  font-family: var(--font-body);\n  font-size: 0.98rem;\n}\n\n.search-input {\n  width: 100%;\n  max-width: 340px;\n}\n\n.zone-select {\n  min-width: 210px;\n  cursor: pointer;\n}\n\n.content {\n  padding-top: 32px;\n}\n\n.result-count {\n  margin-bottom: 24px;\n  color: var(--muted);\n  font-size: 0.95rem;\n  font-weight: 700;\n}\n\n/* Liste */\n\n.animal-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));\n  gap: 30px;\n}\n\n.animal-card {\n  overflow: hidden;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n  transition: box-shadow 0.2s;\n}\n\n.animal-card:hover {\n  box-shadow: 0 0 0 2px var(--green), var(--shadow);\n}\n\n.animal-image {\n  position: relative;\n  height: 210px;\n  overflow: hidden;\n}\n\n.animal-image img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.4s ease;\n}\n\n.animal-card:hover .animal-image img {\n  transform: scale(1.05);\n}\n\n.zone-badge {\n  position: absolute;\n  top: 14px;\n  left: 14px;\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: #fff;\n  color: var(--forest);\n  font-size: 0.78rem;\n  font-weight: 700;\n}\n\n.animal-info {\n  padding: 22px 24px 26px;\n}\n\n.animal-info h2 {\n  color: var(--forest);\n  font-size: 1.6rem;\n}\n\n.description {\n  min-height: 52px;\n  margin-top: 8px;\n  color: var(--muted);\n  font-size: 0.95rem;\n}\n\n.measures {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 10px;\n  margin-top: 18px;\n}\n\n.measure {\n  padding: 12px 8px;\n  background: var(--meadow);\n  border-radius: 14px 4px 14px 4px;\n  text-align: center;\n}\n\n.measure strong {\n  display: block;\n  color: var(--green);\n  font-family: var(--font-display);\n  font-size: 1.05rem;\n}\n\n.measure small {\n  color: var(--muted);\n  font-size: 0.75rem;\n}\n\n.tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.tag {\n  padding: 4px 12px;\n  border-radius: 999px;\n  background: var(--mint);\n  color: var(--forest);\n  font-size: 0.82rem;\n  font-weight: 700;\n}\n\n.empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 18px;\n  padding: 60px 0;\n  color: var(--muted);\n  font-size: 1.15rem;\n}\n\n@media (max-width: 560px) {\n  .animal-list {\n    grid-template-columns: 1fr;\n  }\n}\n</style>"],"mappings":";;;;AACA,OAAOA,OAAM,MAAO,sBAAqB;AACzC,OAAOC,KAAI,MAAO,oBAAmB;AACrC,OAAOC,aAAY,MAAO,4CAA2C;AACrE,OAAOC,UAAS,MAAO,6BAA4B;AAEnD,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,UAAU,EAAE;IAAEF;EAAW,CAAC;EAE1BG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLN,OAAO,EAAEA,OAAO;MAChBC,KAAK,EAAEA,KAAK;MACZC,aAAa,EAAEA,aAAa;MAC5BK,MAAM,EAAE;IACV;EACF,CAAC;EAEDC,QAAQ,EAAE;IACR;IACA;IACAC,YAAY,EAAE;MACZC,GAAGA,CAAA,EAAG;QACJ,OAAO,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,IAAG,GAAIC,MAAM,CAAC,IAAI,CAACH,MAAM,CAACC,KAAK,CAACC,IAAI,IAAI,EAAC;MACpE,CAAC;MACDE,GAAGA,CAACC,KAAK,EAAE;QACT,IAAI,CAACC,OAAO,CAACC,OAAO,CAAC;UAAEN,KAAK,EAAEI,KAAI,GAAI;YAAEH,IAAI,EAAEG;UAAM,IAAI,CAAC;QAAE,CAAC;MAC9D;IACF,CAAC;IAEDG,eAAeA,CAAA,EAAG;MAChB,MAAMC,IAAG,GAAI,IAAI,CAACb,MAAM,CAACc,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC;MAE5C,OAAO,IAAI,CAACtB,OAAO,CAACuB,MAAM,CAACC,MAAK,IAAK;QACnC,MAAMC,SAAQ,GACZ,CAAC,IAAI,CAAChB,YAAW,IAAKK,MAAM,CAACU,MAAM,CAACE,OAAO,MAAM,IAAI,CAACjB,YAAW;QAEnE,MAAMkB,WAAU,GACd,CAACP,IAAG,IACJI,MAAM,CAACI,cAAc,CAACN,WAAW,CAAC,CAAC,CAACO,QAAQ,CAACT,IAAI,KACjDI,MAAM,CAACM,kBAAkB,CAACR,WAAW,CAAC,CAAC,CAACO,QAAQ,CAACT,IAAI;QAEvD,OAAOK,SAAQ,IAAKE,WAAU;MAChC,CAAC;IACH,CAAC;IAEDI,SAASA,CAAA,EAAG;MACV,OAAO,IAAI,CAACxB,MAAM,CAACc,IAAI,CAAC,MAAM,EAAC,IAAK,IAAI,CAACZ,YAAW,KAAM,EAAC;IAC7D;EACF,CAAC;EAEDuB,OAAO,EAAE;IACPC,cAAcA,CAACT,MA