{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport animals from '@/assets/ANIMAL.json';\nimport zones from '@/assets/ZONE.json';\nexport default {\n  name: 'NavBar',\n  data() {\n    return {\n      open: false,\n      closeTimer: null,\n      lastPointer: ''\n    };\n  },\n  computed: {\n    animalCount() {\n      return animals.length;\n    },\n    zoneCount() {\n      return zones.length;\n    },\n    // \"Data\" est surligné quand on est sur /animals ou /zones\n    dataActive() {\n      return ['/animals', '/zones'].includes(this.$route.path);\n    }\n  },\n  watch: {\n    // On referme le menu à chaque changement de page\n    '$route'() {\n      this.open = false;\n    }\n  },\n  mounted() {\n    document.addEventListener('click', this.onDocumentClick);\n  },\n  beforeUnmount() {\n    document.removeEventListener('click', this.onDocumentClick);\n    clearTimeout(this.closeTimer);\n  },\n  methods: {\n    onEnter(event) {\n      this.lastPointer = event.pointerType;\n      if (event.pointerType === 'mouse') {\n        clearTimeout(this.closeTimer);\n        this.open = true;\n      }\n    },\n    onLeave(event) {\n      if (event.pointerType === 'mouse') {\n        // petit délai pour ne pas fermer si le curseur dévie un instant\n        this.closeTimer = setTimeout(() => {\n          this.open = false;\n        }, 150);\n      }\n    },\n    onToggle() {\n      // Souris : le survol l'a déjà ouvert, un clic ne doit pas le refermer\n      if (this.lastPointer === 'mouse') {\n        this.open = true;\n      } else {\n        this.open = !this.open;\n      }\n    },\n    onFocusOut(event) {\n      const next = event.relatedTarget;\n      if (next && !this.$refs.dropdown.contains(next)) {\n        this.open = false;\n      }\n    },\n    onDocumentClick(event) {\n      if (this.$refs.dropdown && !this.$refs.dropdown.contains(event.target)) {\n        this.open = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["animals","zones","name","data","open","closeTimer","lastPointer","computed","animalCount","length","zoneCount","dataActive","includes","$route","path","watch","mounted","document","addEventListener","onDocumentClick","beforeUnmount","removeEventListener","clearTimeout","methods","onEnter","event","pointerType","onLeave","setTimeout","onToggle","onFocusOut","next","relatedTarget","$refs","dropdown","contains","target"],"sources":["/Users/laetitia/Projet-Advanced-Web-Programming-JZ-LB/webapp_clientside/src/components/NavBar.vue"],"sourcesContent":["<template>\n  <header class=\"topbar\">\n    <div class=\"container bar-inner\">\n      <router-link to=\"/\" class=\"logo\">🌿Happy<span>Zoo</span></router-link>\n\n      <nav class=\"links\" aria-label=\"Main navigation\">\n        <router-link to=\"/\" class=\"nav-link\">Home</router-link>\n\n        <!-- Menu déroulant \"Data\" : s'ouvre au survol, un clic sur un choix change de page -->\n        <div\n          ref=\"dropdown\"\n          class=\"dropdown\"\n          @pointerenter=\"onEnter\"\n          @pointerleave=\"onLeave\"\n          @focusout=\"onFocusOut\"\n          @keydown.esc=\"open = false\"\n        >\n          <button\n            type=\"button\"\n            class=\"nav-link dropdown-toggle\"\n            :class=\"{ active: dataActive }\"\n            aria-haspopup=\"true\"\n            :aria-expanded=\"open\"\n            @click=\"onToggle\"\n          >\n            Data <span class=\"chevron\" :class=\"{ up: open }\">▾</span>\n          </button>\n\n          <transition name=\"menu\">\n            <ul v-show=\"open\" class=\"dropdown-menu\">\n              <li>\n                <router-link to=\"/animals\" class=\"dropdown-item\">\n                  <span class=\"item-icon\">🦁</span>\n                  <span class=\"item-text\">\n                    <strong>Animals</strong>\n                    <small>{{ animalCount }} residents</small>\n                  </span>\n                </router-link>\n              </li>\n              <li>\n                <router-link to=\"/zones\" class=\"dropdown-item\">\n                  <span class=\"item-icon\">🗺️</span>\n                  <span class=\"item-text\">\n                    <strong>Zones</strong>\n                    <small>{{ zoneCount }} habitats</small>\n                  </span>\n                </router-link>\n              </li>\n            </ul>\n          </transition>\n        </div>\n\n        <router-link to=\"/tickets\" class=\"nav-link\">Tickets</router-link>\n      </nav>\n\n      <div class=\"actions\">\n        <a href=\"#\" class=\"btn btn-outline btn-sm\" @click.prevent>My Account</a>\n        <router-link to=\"/tickets\" class=\"btn btn-orange btn-sm\">Book Now</router-link>\n      </div>\n    </div>\n  </header>\n</template>\n\n<script>\nimport animals from '@/assets/ANIMAL.json'\nimport zones from '@/assets/ZONE.json'\n\nexport default {\n  name: 'NavBar',\n\n  data() {\n    return {\n      open: false,\n      closeTimer: null,\n      lastPointer: ''\n    }\n  },\n\n  computed: {\n    animalCount() {\n      return animals.length\n    },\n    zoneCount() {\n      return zones.length\n    },\n    // \"Data\" est surligné quand on est sur /animals ou /zones\n    dataActive() {\n      return ['/animals', '/zones'].includes(this.$route.path)\n    }\n  },\n\n  watch: {\n    // On referme le menu à chaque changement de page\n    '$route'() {\n      this.open = false\n    }\n  },\n\n  mounted() {\n    document.addEventListener('click', this.onDocumentClick)\n  },\n\n  beforeUnmount() {\n    document.removeEventListener('click', this.onDocumentClick)\n    clearTimeout(this.closeTimer)\n  },\n\n  methods: {\n    onEnter(event) {\n      this.lastPointer = event.pointerType\n      if (event.pointerType === 'mouse') {\n        clearTimeout(this.closeTimer)\n        this.open = true\n      }\n    },\n    onLeave(event) {\n      if (event.pointerType === 'mouse') {\n        // petit délai pour ne pas fermer si le curseur dévie un instant\n        this.closeTimer = setTimeout(() => {\n          this.open = false\n        }, 150)\n      }\n    },\n    onToggle() {\n      // Souris : le survol l'a déjà ouvert, un clic ne doit pas le refermer\n      if (this.lastPointer === 'mouse') {\n        this.open = true\n      } else {\n        this.open = !this.open\n      }\n    },\n    onFocusOut(event) {\n      const next = event.relatedTarget\n      if (next && !this.$refs.dropdown.contains(next)) {\n        this.open = false\n      }\n    },\n    onDocumentClick(event) {\n      if (this.$refs.dropdown && !this.$refs.dropdown.contains(event.target)) {\n        this.open = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.topbar {\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  padding: 14px 0;\n  background: rgba(255, 255, 255, 0.96);\n  border-bottom: 1px solid var(--line);\n}\n\n.bar-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n\n.logo {\n  font-family: var(--font-display);\n  font-size: 1.7rem;\n  font-weight: 800;\n  color: var(--forest);\n}\n\n.logo span {\n  color: var(--orange);\n}\n\n.links {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.nav-link {\n  padding: 8px 14px;\n  border: none;\n  border-radius: 999px;\n  background: none;\n  color: var(--ink);\n  font-family: var(--font-body);\n  font-size: 0.98rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.nav-link:hover {\n  background: var(--meadow);\n  color: var(--green);\n}\n\n.nav-link.router-link-exact-active,\n.nav-link.active {\n  background: var(--mint);\n  color: var(--forest);\n}\n\n.chevron {\n  display: inline-block;\n  font-size: 0.8rem;\n  transition: transform 0.2s;\n}\n\n.chevron.up {\n  transform: rotate(180deg);\n}\n\n/* ---------- Menu déroulant ---------- */\n\n.dropdown {\n  position: relative;\n}\n\n.dropdown-menu {\n  position: absolute;\n  top: calc(100% + 8px);\n  left: 0;\n  min-width: 230px;\n  margin: 0;\n  padding: 8px;\n  list-style: none;\n  background: #fff;\n  border: 1px solid var(--line);\n  border-radius: 20px 6px 20px 6px;\n  box-shadow: 0 14px 34px rgba(30, 58, 43, 0.16);\n}\n\n/* zone invisible qui comble l'espace entre le bouton et le menu */\n.dropdown-menu::before {\n  content: '';\n  position: absolute;\n  top: -10px;\n  left: 0;\n  right: 0;\n  height: 10px;\n}\n\n.dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 12px;\n  border-radius: 12px;\n  transition: background-color 0.15s;\n}\n\n.dropdown-item:hover,\n.dropdown-item:focus-visible {\n  background: var(--meadow);\n}\n\n.dropdown-item.router-link-exact-active {\n  background: var(--mint);\n}\n\n.item-icon {\n  font-size: 1.4rem;\n}\n\n.item-text strong {\n  display: block;\n  color: var(--forest);\n}\n\n.item-text small {\n  color: var(--muted);\n}\n\n.menu-enter-active,\n.menu-leave-active {\n  transition: opacity 0.15s ease;\n}\n\n.menu-enter-from,\n.menu-leave-to {\n  opacity: 0;\n}\n\n.actions {\n  display: flex;\n  gap: 10px;\n}\n\n@media (max-width: 960px) {\n  .bar-inner {\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .links {\n    flex-wrap: wrap;\n    justify-content: center;\n  }\n\n  .dropdown-menu {\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n</style>"],"mappings":";AAgEA,OAAOA,OAAM,MAAO,sBAAqB;AACzC,OAAOC,KAAI,MAAO,oBAAmB;AAErC,eAAe;EACbC,IAAI,EAAE,QAAQ;EAEdC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,KAAK;MACXC,UAAU,EAAE,IAAI;MAChBC,WAAW,EAAE;IACf;EACF,CAAC;EAEDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,OAAOR,OAAO,CAACS,MAAK;IACtB,CAAC;IACDC,SAASA,CAAA,EAAG;MACV,OAAOT,KAAK,CAACQ,MAAK;IACpB,CAAC;IACD;IACAE,UAAUA,CAAA,EAAG;MACX,OAAO,CAAC,UAAU,EAAE,QAAQ,CAAC,CAACC,QAAQ,CAAC,IAAI,CAACC,MAAM,CAACC,IAAI;IACzD;EACF,CAAC;EAEDC,KAAK,EAAE;IACL;IACA,QAAQF,CAAA,EAAG;MACT,IAAI,CAACT,IAAG,GAAI,KAAI;IAClB;EACF,CAAC;EAEDY,OAAOA,CAAA,EAAG;IACRC,QAAQ,CAACC,gBAAgB,CAAC,OAAO,EAAE,IAAI,CAACC,eAAe;EACzD,C