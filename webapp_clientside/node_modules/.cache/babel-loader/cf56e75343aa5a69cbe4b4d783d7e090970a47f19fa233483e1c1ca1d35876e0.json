{"ast":null,"code":"export default {\n  name: 'TicketStub',\n  props: {\n    ticket: {\n      type: Object,\n      required: true\n    }\n  }\n};","map":{"version":3,"names":["name","props","ticket","type","Object","required"],"sources":["/Users/laetitia/Projet-Advanced-Web-Programming-JZ-LB/webapp_clientside/src/components/TicketStub.vue"],"sourcesContent":["<template>\n  <article class=\"stub\" :class=\"{ popular: ticket.popular }\">\n    <div class=\"stub-main\">\n      <span v-if=\"ticket.popular\" class=\"tag\">Most popular</span>\n      <span class=\"stub-emoji\" aria-hidden=\"true\">{{ ticket.emoji }}</span>\n      <h3>{{ ticket.name }}</h3>\n      <p class=\"ages\">{{ ticket.ages }}</p>\n      <ul class=\"perks\">\n        <li v-for=\"perk in ticket.perks\" :key=\"perk\">{{ perk }}</li>\n      </ul>\n    </div>\n\n    <!-- Ligne de découpe du billet -->\n    <div class=\"stub-foot\">\n      <div class=\"price\">\n        {{ ticket.price }}€ <small>{{ ticket.unit }}</small>\n      </div>\n      <div class=\"stub-action\">\n        <slot />\n      </div>\n    </div>\n  </article>\n</template>\n\n<script>\nexport default {\n  name: 'TicketStub',\n  props: {\n    ticket: { type: Object, required: true }\n  }\n}\n</script>\n\n<style scoped>\n.stub {\n  display: flex;\n  flex-direction: column;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n}\n\n.stub.popular {\n  box-shadow: 0 0 0 2px var(--orange), var(--shadow);\n}\n\n.stub-main {\n  position: relative;\n  flex: 1;\n  padding: 28px 26px 22px;\n}\n\n.tag {\n  position: absolute;\n  top: 18px;\n  right: 18px;\n  padding: 3px 11px;\n  border-radius: 999px;\n  background: var(--orange);\n  color: #fff;\n  font-size: 0.72rem;\n  font-weight: 700;\n}\n\n.stub-emoji {\n  display: grid;\n  place-items: center;\n  width: 56px;\n  height: 56px;\n  margin-bottom: 14px;\n  background: var(--mint);\n  border-radius: 18px 4px 18px 4px;\n  font-size: 1.8rem;\n}\n\nh3 {\n  color: var(--forest);\n  font-size: 1.4rem;\n}\n\n.ages {\n  margin-top: 4px;\n  color: var(--muted);\n  font-size: 0.92rem;\n}\n\n.perks {\n  margin: 18px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.perks li {\n  position: relative;\n  padding: 5px 0 5px 24px;\n  color: var(--muted);\n  font-size: 0.92rem;\n}\n\n.perks li::before {\n  content: '✔';\n  position: absolute;\n  left: 0;\n  color: var(--green);\n  font-weight: 700;\n}\n\n/* Pied du billet avec encoches */\n.stub-foot {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n  padding: 20px 26px 24px;\n  border-top: 2px dashed var(--line);\n}\n\n.stub-foot::before,\n.stub-foot::after {\n  content: '';\n  position: absolute;\n  top: -15px;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: var(--notch, var(--cream));\n}\n\n.stub-foot::before { left: -14px; }\n.stub-foot::after { right: -14px; }\n\n.price {\n  font-family: var(--font-display);\n  font-size: 2rem;\n  font-weight: 800;\n  color: var(--forest);\n}\n\n.price small {\n  font-family: var(--font-body);\n  font-size: 0.8rem;\n  font-weight: 400;\n  color: var(--muted);\n}\n</style>"],"mappings":"AAyBA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE;IACLC,MAAM,EAAE;MAAEC,IAAI,EAAEC,MAAM;MAAEC,QAAQ,EAAE;IAAK;EACzC;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}