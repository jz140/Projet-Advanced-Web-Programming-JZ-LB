{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport animals from '@/assets/ANIMAL.json';\nimport zones from '@/assets/ZONE.json';\nimport defaultAnimal from '@/assets/animals_images/default-animal.jpg';\nexport default {\n  name: 'AnimalList',\n  data() {\n    return {\n      animals: animals,\n      zones: zones,\n      defaultAnimal: defaultAnimal,\n      search: ''\n    };\n  },\n  computed: {\n    // La zone choisie est stockée dans l'URL (/animals?zone=2),\n    // ce qui permet d'arriver ici depuis la page des zones déjà filtré.\n    selectedZone: {\n      get() {\n        return this.$route.query.zone ? String(this.$route.query.zone) : '';\n      },\n      set(value) {\n        this.$router.replace({\n          query: value ? {\n            zone: value\n          } : {}\n        });\n      }\n    },\n    filteredAnimals() {\n      const text = this.search.trim().toLowerCase();\n      return this.animals.filter(animal => {\n        const matchZone = !this.selectedZone || String(animal.id_zone) === this.selectedZone;\n        const matchSearch = !text || animal.species_animal.toLowerCase().includes(text) || animal.description_animal.toLowerCase().includes(text);\n        return matchZone && matchSearch;\n      });\n    },\n    hasFilter() {\n      return this.search.trim() !== '' || this.selectedZone !== '';\n    }\n  },\n  methods: {\n    getAnimalImage(animal) {\n      try {\n        return require('@/assets/animals_images/' + animal.species_animal.replaceAll(' ', '_') + '.jpg');\n      } catch (error) {\n        return this.defaultAnimal;\n      }\n    },\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone);\n      return zone ? zone.name_zone : '';\n    },\n    resetFilters() {\n      this.search = '';\n      this.selectedZone = '';\n    }\n  }\n};","map":{"version":3,"names":["animals","zones","defaultAnimal","name","data","search","computed","selectedZone","get","$route","query","zone","String","set","value","$router","replace","filteredAnimals","text","trim","toLowerCase","filter","animal","matchZone","id_zone","matchSearch","species_animal","includes","description_animal","hasFilter","methods","getAnimalImage","require","replaceAll","error","zoneName","idZone","find","z","name_zone","resetFilters"],"sources":["/Users/jackyzhang/webapp_clientside/src/views/AnimalList.vue"],"sourcesContent":["<script>\nimport animals from '@/assets/ANIMAL.json'\nimport zones from '@/assets/ZONE.json'\nimport defaultAnimal from '@/assets/animals_images/default-animal.jpg'\n\nexport default {\n  name: 'AnimalList',\n\n  data() {\n    return {\n      animals: animals,\n      zones: zones,\n      defaultAnimal: defaultAnimal,\n      search: ''\n    }\n  },\n\n  computed: {\n    // La zone choisie est stockée dans l'URL (/animals?zone=2),\n    // ce qui permet d'arriver ici depuis la page des zones déjà filtré.\n    selectedZone: {\n      get() {\n        return this.$route.query.zone ? String(this.$route.query.zone) : ''\n      },\n      set(value) {\n        this.$router.replace({ query: value ? { zone: value } : {} })\n      }\n    },\n\n    filteredAnimals() {\n      const text = this.search.trim().toLowerCase()\n\n      return this.animals.filter(animal => {\n        const matchZone =\n          !this.selectedZone || String(animal.id_zone) === this.selectedZone\n\n        const matchSearch =\n          !text ||\n          animal.species_animal.toLowerCase().includes(text) ||\n          animal.description_animal.toLowerCase().includes(text)\n\n        return matchZone && matchSearch\n      })\n    },\n\n    hasFilter() {\n      return this.search.trim() !== '' || this.selectedZone !== ''\n    }\n  },\n\n  methods: {\n    getAnimalImage(animal) {\n      try {\n        return require(\n          '@/assets/animals_images/' +\n          animal.species_animal.replaceAll(' ', '_') +\n          '.jpg'\n        )\n      } catch (error) {\n        return this.defaultAnimal\n      }\n    },\n\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone)\n      return zone ? zone.name_zone : ''\n    },\n\n    resetFilters() {\n      this.search = ''\n      this.selectedZone = ''\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"animals-page\">\n\n    <router-link to=\"/\" class=\"back-link\">← Back to home</router-link>\n\n    <!-- Titre -->\n    <div class=\"page-header\">\n      <h1>🦁 HappyZoo Animals</h1>\n      <p>Discover all the amazing animals living in our zoo.</p>\n    </div>\n\n    <!-- Recherche et filtre -->\n    <div class=\"toolbar\">\n      <input\n        v-model=\"search\"\n        type=\"search\"\n        class=\"search-input\"\n        placeholder=\"Search an animal...\"\n        aria-label=\"Search an animal\"\n      >\n\n      <select v-model=\"selectedZone\" class=\"zone-select\" aria-label=\"Filter by zone\">\n        <option value=\"\">All zones</option>\n        <option\n          v-for=\"zone in zones\"\n          :key=\"zone.id_zone\"\n          :value=\"String(zone.id_zone)\"\n        >\n          {{ zone.name_zone }}\n        </option>\n      </select>\n\n      <button v-if=\"hasFilter\" type=\"button\" class=\"reset-button\" @click=\"resetFilters\">\n        Reset\n      </button>\n    </div>\n\n    <p class=\"result-count\">\n      {{ filteredAnimals.length }}\n      {{ filteredAnimals.length === 1 ? 'animal' : 'animals' }} found\n    </p>\n\n    <!-- Liste des animaux -->\n    <div v-if=\"filteredAnimals.length\" class=\"animal-list\">\n\n      <div\n        v-for=\"animal in filteredAnimals\"\n        :key=\"animal.id_animal\"\n        class=\"animal-card\"\n      >\n\n        <!-- Image -->\n        <div class=\"animal-image\">\n          <img\n            :src=\"getAnimalImage(animal)\"\n            :alt=\"animal.species_animal\"\n          >\n          <span class=\"zone-badge\">{{ zoneName(animal.id_zone) }}</span>\n        </div>\n\n        <!-- Informations -->\n        <div class=\"animal-info\">\n\n          <h2>{{ animal.species_animal }}</h2>\n\n          <p class=\"description\">\n            {{ animal.description_animal }}\n          </p>\n\n          <div class=\"details\">\n\n            <div class=\"detail\">\n              <span class=\"icon\">⚥</span>\n              <div>\n                <small>Gender</small>\n                <strong>{{ animal.gender_animal }}</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">🌍</span>\n              <div>\n                <small>Habitat</small>\n                <strong>{{ animal.habitat_animal }}</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">📏</span>\n              <div>\n                <small>Length</small>\n                <strong>{{ animal.length_animal }} m</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">📐</span>\n              <div>\n                <small>Height</small>\n                <strong>{{ animal.height_animal }} m</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">⚖️</span>\n              <div>\n                <small>Weight</small>\n                <strong>{{ animal.weight_animal }} kg</strong>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n\n    <!-- Aucun résultat -->\n    <div v-else class=\"empty\">\n      <p>No animal matches your search.</p>\n      <button type=\"button\" class=\"back-button\" @click=\"resetFilters\">Reset filters</button>\n    </div>\n\n    <div class=\"page-footer\">\n      <router-link to=\"/\" class=\"back-button\">← Back to home</router-link>\n      <router-link to=\"/zones\" class=\"back-button back-button-alt\">See the zones</router-link>\n    </div>\n\n  </div>\n</template>\n\n<style scoped>\n\n.animals-page {\n  min-height: 100vh;\n  padding: 30px 8% 50px;\n  background: #f3f7f1;\n}\n\n/* BACK LINK */\n\n.back-link {\n  display: inline-block;\n  padding: 8px 16px;\n  border-radius: 20px;\n  background: white;\n  color: #245c3a;\n  font-weight: bold;\n  font-size: 14px;\n  text-decoration: none;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.back-link:hover {\n  background: #245c3a;\n  color: white;\n}\n\n/* HEADER */\n\n.page-header {\n  text-align: center;\n  margin: 10px 0 35px;\n}\n\n.page-header h1 {\n  margin: 0;\n  color: #245c3a;\n  font-size: 42px;\n  font-weight: 700;\n}\n\n.page-header p {\n  margin-top: 12px;\n  color: #68756d;\n  font-size: 18px;\n}\n\n/* TOOLBAR */\n\n.toolbar {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.search-input,\n.zone-select {\n  padding: 12px 16px;\n  border: 1px solid #d5e2d8;\n  border-radius: 10px;\n  background: white;\n  color: #245c3a;\n  font-size: 15px;\n  font-family: inherit;\n}\n\n.search-input {\n  width: 100%;\n  max-width: 340px;\n}\n\n.zone-select {\n  min-width: 200px;\n  cursor: pointer;\n}\n\n.reset-button {\n  padding: 12px 18px;\n  border: 2px solid #d97706;\n  border-radius: 10px;\n  background: transparent;\n  color: #d97706;\n  font-weight: bold;\n  font-family: inherit;\n  cursor: pointer;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.reset-button:hover {\n  background: #d97706;\n  color: white;\n}\n\n.result-count {\n  margin: 20px 0 30px;\n  text-align: center;\n  color: #68756d;\n  font-size: 14px;\n}\n\n/* LIST */\n\n.animal-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n  gap: 30px;\n}\n\n/* CARD */\n\n.animal-card {\n  background: white;\n  border-radius: 18px;\n  overflow: hidden;\n\n  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);\n\n  transition:\n    transform 0.25s ease,\n    box-shadow 0.25s ease;\n}\n\n.animal-card:hover {\n  transform: translateY(-8px);\n\n  box-shadow:\n    0 15px 35px rgba(0, 0, 0, 0.15);\n}\n\n/* IMAGE */\n\n.animal-image {\n  position: relative;\n  width: 100%;\n  height: 220px;\n  overflow: hidden;\n}\n\n.animal-image img {\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n\n  display: block;\n\n  transition: transform 0.4s ease;\n}\n\n.animal-card:hover .animal-image img {\n  transform: scale(1.08);\n}\n\n.zone-badge {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  padding: 4px 10px;\n  border-radius: 4px;\n  background: white;\n  color: #245c3a;\n  font-size: 12px;\n  font-weight: bold;\n}\n\n/* INFORMATION */\n\n.animal-info {\n  padding: 25px;\n}\n\n.animal-info h2 {\n  margin: 0 0 12px;\n\n  color: #245c3a;\n\n  font-size: 25px;\n}\n\n.description {\n  color: #68756d;\n  line-height: 1.6;\n  min-height: 75px;\n}\n\n/* DETAILS */\n\n.details {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n\n  gap: 12px;\n\n  margin-top: 20px;\n}\n\n.detail {\n  display: flex;\n  align-items: center;\n\n  gap: 10px;\n\n  padding: 10px;\n\n  background: #f3f7f1;\n\n  border-radius: 10px;\n}\n\n.icon {\n  font-size: 20px;\n}\n\n.detail small {\n  display: block;\n\n  color: #7b887f;\n\n  font-size: 11px;\n}\n\n.detail strong {\n  display: block;\n\n  color: #245c3a;\n\n  font-size: 14px;\n}\n\n/* EMPTY */\n\n.empty {\n  padding: 40px 0;\n  text-align: center;\n  color: #68756d;\n  font-size: 18px;\n}\n\n/* BOTTOM BUTTONS */\n\n.page-footer {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 15px;\n  margin-top: 50px;\n}\n\n.back-button {\n  padding: 12px 22px;\n  border-radius: 6px;\n  background: #2d6a4f;\n  border: 2px solid #2d6a4f;\n  color: white;\n  font-weight: bold;\n  font-size: 16px;\n  font-family: inherit;\n  text-decoration: none;\n  cursor: pointer;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.back-button:hover {\n  background: #1b4332;\n  border-color: #1b4332;\n}\n\n.back-button-alt {\n  background: transparent;\n  color: #2d6a4f;\n}\n\n.back-button-alt:hover {\n  background: #2d6a4f;\n  border-color: #2d6a4f;\n  color: white;\n}\n\n:focus-visible {\n  outline: 3px solid #d97706;\n  outline-offset: 2px;\n}\n\n/* MOBILE */\n\n@media (max-width: 600px) {\n\n  .animals-page {\n    padding: 20px 20px 40px;\n  }\n\n  .page-header h1 {\n    font-size: 32px;\n  }\n\n  .animal-list {\n    grid-template-columns: 1fr;\n  }\n\n  .details {\n    grid-template-columns: 1fr;\n  }\n\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .animal-card,\n  .animal-image img,\n  .back-link,\n  .back-button {\n    transition: none;\n  }\n\n  .animal-card:hover {\n    transform: none;\n  }\n\n  .animal-card:hover .animal-image img {\n    transform: none;\n  }\n}\n\n</style>"],"mappings":";;;;AACA,OAAOA,OAAM,MAAO,sBAAqB;AACzC,OAAOC,KAAI,MAAO,oBAAmB;AACrC,OAAOC,aAAY,MAAO,4CAA2C;AAErE,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLJ,OAAO,EAAEA,OAAO;MAChBC,KAAK,EAAEA,KAAK;MACZC,aAAa,EAAEA,aAAa;MAC5BG,MAAM,EAAE;IACV;EACF,CAAC;EAEDC,QAAQ,EAAE;IACR;IACA;IACAC,YAAY,EAAE;MACZC,GAAGA,CAAA,EAAG;QACJ,OAAO,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,IAAG,GAAIC,MAAM,CAAC,IAAI,CAACH,MAAM,CAACC,KAAK,CAACC,IAAI,IAAI,EAAC;MACpE,CAAC;MACDE,GAAGA,CAACC,KAAK,EAAE;QACT,IAAI,CAACC,OAAO,CAACC,OAAO,CAAC;UAAEN,KAAK,EAAEI,KAAI,GAAI;YAAEH,IAAI,EAAEG;UAAM,IAAI,CAAC;QAAE,CAAC;MAC9D;IACF,CAAC;IAEDG,eAAeA,CAAA,EAAG;MAChB,MAAMC,IAAG,GAAI,IAAI,CAACb,MAAM,CAACc,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC;MAE5C,OAAO,IAAI,CAACpB,OAAO,CAACqB,MAAM,CAACC,MAAK,IAAK;QACnC,MAAMC,SAAQ,GACZ,CAAC,IAAI,CAAChB,YAAW,IAAKK,MAAM,CAACU,MAAM,CAACE,OAAO,MAAM,IAAI,CAACjB,YAAW;QAEnE,MAAMkB,WAAU,GACd,CAACP,IAAG,IACJI,MAAM,CAACI,cAAc,CAACN,WAAW,CAAC,CAAC,CAACO,QAAQ,CAACT,IAAI,KACjDI,MAAM,CAACM,kBAAkB,CAACR,WAAW,CAAC,CAAC,CAACO,QAAQ,CAACT,IAAI;QAEvD,OAAOK,SAAQ,IAAKE,WAAU;MAChC,CAAC;IACH,CAAC;IAEDI,SAASA,CAAA,EAAG;MACV,OAAO,IAAI,CAACxB,MAAM,CAACc,IAAI,CAAC,MAAM,EAAC,IAAK,IAAI,CAACZ,YAAW,KAAM,EAAC;IAC7D;EACF,CAAC;EAEDuB,OAAO,EAAE;IACPC,cAAcA,CAACT,MAAM,EAAE;MACrB,IAAI;QACF,OAAOU,OAAO,CACZ,0BAAyB,GACzBV,MAAM,CAACI,cAAc,CAACO,UAAU,CAAC,GAAG,EAAE,GAAG,IACzC,MACF;MACF,EAAE,OAAOC,KAAK,EAAE;QACd,OAAO,IAAI,CAAChC,aAAY;MAC1B;IACF,CAAC;IAEDiC,QAAQA,CAACC,MAAM,EAAE;MACf,MAAMzB,IAAG,GAAI,IAAI,CAACV,KAAK,CAACoC,IAAI,CAACC,CAAA,IAAKA,CAAC,CAACd,OAAM,KAAMY,MAAM;MACtD,OAAOzB,IAAG,GAAIA,IAAI,CAAC4B,SAAQ,GAAI,EAAC;IAClC,CAAC;IAEDC,YAAYA,CAAA,EAAG;MACb,IAAI,CAACnC,MAAK,GAAI,EAAC;MACf,IAAI,CAACE,YAAW,GAAI,EAAC;IACvB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}