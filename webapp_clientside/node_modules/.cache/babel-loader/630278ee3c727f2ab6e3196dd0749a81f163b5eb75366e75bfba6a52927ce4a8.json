{"ast":null,"code":"import animals from '@/assets/ANIMAL.json';\nimport defaultAnimal from '@/assets/images/default-animal.jpg';\nexport default {\n  name: 'AnimalList',\n  data() {\n    return {\n      animals: animals,\n      defaultAnimal: defaultAnimal\n    };\n  },\n  methods: {\n    getAnimalImage(animal) {\n      try {\n        return require('@/assets/images/' + animal.species_animal.replaceAll(' ', '_') + '.jpg');\n      } catch (error) {\n        return this.defaultAnimal;\n      }\n    }\n  }\n};","map":{"version":3,"names":["animals","defaultAnimal","name","data","methods","getAnimalImage","animal","require","species_animal","replaceAll","error"],"sources":["/Users/jackyzhang/webapp_clientside/src/views/AnimalList.vue"],"sourcesContent":["<script>\nimport animals from '@/assets/ANIMAL.json'\nimport defaultAnimal from '@/assets/images/default-animal.jpg'\n\nexport default {\n  name: 'AnimalList',\n\n  data() {\n    return {\n      animals: animals,\n      defaultAnimal: defaultAnimal\n    }\n  },\n\n  methods: {\n    getAnimalImage(animal) {\n      try {\n        return require(\n          '@/assets/images/' +\n          animal.species_animal.replaceAll(' ', '_') +\n          '.jpg'\n        )\n      } catch (error) {\n        return this.defaultAnimal\n      }\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"animals-page\">\n\n    <!-- Titre -->\n    <div class=\"page-header\">\n      <h1>🦁 HappyZoo Animals</h1>\n      <p>Discover all the amazing animals living in our zoo.</p>\n    </div>\n\n    <!-- Liste des animaux -->\n    <div class=\"animal-list\">\n\n      <div\n        v-for=\"animal in animals\"\n        :key=\"animal.id_animal\"\n        class=\"animal-card\"\n      >\n\n        <!-- Image -->\n        <div class=\"animal-image\">\n          <img\n            :src=\"getAnimalImage(animal)\"\n            :alt=\"animal.species_animal\"\n          >\n        </div>\n\n        <!-- Informations -->\n        <div class=\"animal-info\">\n\n          <h2>{{ animal.species_animal }}</h2>\n\n          <p class=\"description\">\n            {{ animal.description_animal }}\n          </p>\n\n          <div class=\"details\">\n\n            <div class=\"detail\">\n              <span class=\"icon\">⚥</span>\n              <div>\n                <small>Gender</small>\n                <strong>{{ animal.gender_animal }}</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">🌍</span>\n              <div>\n                <small>Habitat</small>\n                <strong>{{ animal.habitat_animal }}</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">📏</span>\n              <div>\n                <small>Length</small>\n                <strong>{{ animal.length_animal }} m</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">📐</span>\n              <div>\n                <small>Height</small>\n                <strong>{{ animal.height_animal }} m</strong>\n              </div>\n            </div>\n\n            <div class=\"detail\">\n              <span class=\"icon\">⚖️</span>\n              <div>\n                <small>Weight</small>\n                <strong>{{ animal.weight_animal }} kg</strong>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n</template>\n\n<style scoped>\n\n.animals-page {\n  min-height: 100vh;\n  padding: 50px 8%;\n  background: #f3f7f1;\n}\n\n/* HEADER */\n\n.page-header {\n  text-align: center;\n  margin-bottom: 50px;\n}\n\n.page-header h1 {\n  margin: 0;\n  color: #245c3a;\n  font-size: 42px;\n  font-weight: 700;\n}\n\n.page-header p {\n  margin-top: 12px;\n  color: #68756d;\n  font-size: 18px;\n}\n\n/* LIST */\n\n.animal-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n  gap: 30px;\n}\n\n/* CARD */\n\n.animal-card {\n  background: white;\n  border-radius: 18px;\n  overflow: hidden;\n\n  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);\n\n  transition:\n    transform 0.25s ease,\n    box-shadow 0.25s ease;\n}\n\n.animal-card:hover {\n  transform: translateY(-8px);\n\n  box-shadow:\n    0 15px 35px rgba(0, 0, 0, 0.15);\n}\n\n/* IMAGE */\n\n.animal-image {\n  width: 100%;\n  height: 220px;\n  overflow: hidden;\n}\n\n.animal-image img {\n  width: 100%;\n  height: 100%;\n\n  object-fit: cover;\n\n  display: block;\n\n  transition: transform 0.4s ease;\n}\n\n.animal-card:hover .animal-image img {\n  transform: scale(1.08);\n}\n\n/* INFORMATION */\n\n.animal-info {\n  padding: 25px;\n}\n\n.animal-info h2 {\n  margin: 0 0 12px;\n\n  color: #245c3a;\n\n  font-size: 25px;\n}\n\n.description {\n  color: #68756d;\n  line-height: 1.6;\n  min-height: 75px;\n}\n\n/* DETAILS */\n\n.details {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n\n  gap: 12px;\n\n  margin-top: 20px;\n}\n\n.detail {\n  display: flex;\n  align-items: center;\n\n  gap: 10px;\n\n  padding: 10px;\n\n  background: #f3f7f1;\n\n  border-radius: 10px;\n}\n\n.icon {\n  font-size: 20px;\n}\n\n.detail small {\n  display: block;\n\n  color: #7b887f;\n\n  font-size: 11px;\n}\n\n.detail strong {\n  display: block;\n\n  color: #245c3a;\n\n  font-size: 14px;\n}\n\n/* MOBILE */\n\n@media (max-width: 600px) {\n\n  .animals-page {\n    padding: 30px 20px;\n  }\n\n  .page-header h1 {\n    font-size: 32px;\n  }\n\n  .animal-list {\n    grid-template-columns: 1fr;\n  }\n\n  .details {\n    grid-template-columns: 1fr;\n  }\n\n}\n\n</style>"],"mappings":"AACA,OAAOA,OAAM,MAAO,sBAAqB;AACzC,OAAOC,aAAY,MAAO,oCAAmC;AAE7D,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLH,OAAO,EAAEA,OAAO;MAChBC,aAAa,EAAEA;IACjB;EACF,CAAC;EAEDG,OAAO,EAAE;IACPC,cAAcA,CAACC,MAAM,EAAE;MACrB,IAAI;QACF,OAAOC,OAAO,CACZ,kBAAiB,GACjBD,MAAM,CAACE,cAAc,CAACC,UAAU,CAAC,GAAG,EAAE,GAAG,IACzC,MACF;MACF,EAAE,OAAOC,KAAK,EAAE;QACd,OAAO,IAAI,CAACT,aAAY;MAC1B;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}