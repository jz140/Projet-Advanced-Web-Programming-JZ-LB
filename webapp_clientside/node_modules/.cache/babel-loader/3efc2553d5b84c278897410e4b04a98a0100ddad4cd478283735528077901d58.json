{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport zones from '@/assets/ZONE.json';\nimport { experiences } from '@/data/experiences';\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle';\nimport PageHeader from '@/components/PageHeader.vue';\nexport default {\n  name: 'ExperiencesPage',\n  components: {\n    PageHeader\n  },\n  data() {\n    return {\n      zones,\n      filter: 'all',\n      filters: [{\n        id: 'all',\n        label: 'All'\n      }, {\n        id: 'kids',\n        label: 'Kid friendly'\n      }, {\n        id: 'older',\n        label: 'Teens & adults'\n      }]\n    };\n  },\n  computed: {\n    featured() {\n      return experiences.find(e => e.featured);\n    },\n    // La grille montre les autres expériences (la vedette est en haut de page)\n    visible() {\n      return experiences.filter(e => {\n        if (e.featured) return false;\n        if (this.filter === 'kids') return e.minAge <= 6;\n        if (this.filter === 'older') return e.minAge > 6;\n        return true;\n      });\n    }\n  },\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone);\n      return zone ? zone.name_zone : '';\n    }\n  }\n};","map":{"version":3,"names":["zones","experiences","zoneEmoji","zoneBackground","PageHeader","name","components","data","filter","filters","id","label","computed","featured","find","e","visible","minAge","methods","zoneName","idZone","zone","z","id_zone","name_zone"],"sources":["/Users/jackyzhang/webapp_clientside/src/views/ExperiencesPage.vue"],"sourcesContent":["<script>\nimport zones from '@/assets/ZONE.json'\nimport { experiences } from '@/data/experiences'\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle'\nimport PageHeader from '@/components/PageHeader.vue'\n\nexport default {\n  name: 'ExperiencesPage',\n\n  components: { PageHeader },\n\n  data() {\n    return {\n      zones,\n      filter: 'all',\n      filters: [\n        { id: 'all', label: 'All' },\n        { id: 'kids', label: 'Kid friendly' },\n        { id: 'older', label: 'Teens & adults' }\n      ]\n    }\n  },\n\n  computed: {\n    featured() {\n      return experiences.find(e => e.featured)\n    },\n\n    // La grille montre les autres expériences (la vedette est en haut de page)\n    visible() {\n      return experiences.filter(e => {\n        if (e.featured) return false\n        if (this.filter === 'kids') return e.minAge <= 6\n        if (this.filter === 'older') return e.minAge > 6\n        return true\n      })\n    }\n  },\n\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n\n    zoneName(idZone) {\n      const zone = this.zones.find(z => z.id_zone === idZone)\n      return zone ? zone.name_zone : ''\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"exp-page\">\n\n    <PageHeader\n      title=\"Experiences\"\n      lead=\"Go beyond the path: feed, walk and meet the animals with our team.\"\n      icon=\"🧑‍🌾\"\n    />\n\n    <div class=\"container content\">\n\n      <!-- Expérience vedette -->\n      <section v-if=\"featured\" class=\"featured\">\n        <div class=\"featured-art\" :style=\"{ background: zoneBackground(featured.zoneId) }\">\n          <span aria-hidden=\"true\">{{ zoneEmoji(featured.zoneId) }}</span>\n        </div>\n\n        <div class=\"featured-body\">\n          <span class=\"flag\">Our favourite</span>\n          <h2>{{ featured.title }}</h2>\n          <p>{{ featured.summary }}</p>\n\n          <div class=\"facts\">\n            <span>⏱ {{ featured.duration }}</span>\n            <span>🎟 {{ featured.price }}€ per person</span>\n            <span>👤 From {{ featured.minAge }} years old</span>\n          </div>\n\n          <ul class=\"includes\">\n            <li v-for=\"item in featured.includes\" :key=\"item\">{{ item }}</li>\n          </ul>\n\n          <div class=\"times\">\n            <small>Starts at</small>\n            <span v-for=\"time in featured.times\" :key=\"time\" class=\"time\">{{ time }}</span>\n          </div>\n\n          <router-link\n            :to=\"{ path: '/tickets', query: { experience: featured.id } }\"\n            class=\"btn btn-orange\"\n          >\n            Book this experience\n          </router-link>\n        </div>\n      </section>\n\n      <!-- Filtres -->\n      <div class=\"filters\" role=\"group\" aria-label=\"Filter experiences\">\n        <button\n          v-for=\"f in filters\"\n          :key=\"f.id\"\n          type=\"button\"\n          class=\"filter\"\n          :class=\"{ on: filter === f.id }\"\n          :aria-pressed=\"filter === f.id\"\n          @click=\"filter = f.id\"\n        >\n          {{ f.label }}\n        </button>\n      </div>\n\n      <!-- Grille -->\n      <div v-if=\"visible.length\" class=\"grid\">\n        <article v-for=\"exp in visible\" :key=\"exp.id\" class=\"card\">\n          <div class=\"card-top\" :style=\"{ background: zoneBackground(exp.zoneId) }\">\n            <span class=\"zone-chip\">{{ zoneName(exp.zoneId) }}</span>\n            <span class=\"card-emoji\" aria-hidden=\"true\">{{ zoneEmoji(exp.zoneId) }}</span>\n          </div>\n\n          <div class=\"card-body\">\n            <h3>{{ exp.title }}</h3>\n            <p>{{ exp.summary }}</p>\n\n            <div class=\"meta\">\n              <span>⏱ {{ exp.duration }}</span>\n              <span>👤 {{ exp.minAge }}+</span>\n              <strong>{{ exp.price }}€</strong>\n            </div>\n\n            <div class=\"times\">\n              <small>Starts at</small>\n              <span v-for=\"time in exp.times\" :key=\"time\" class=\"time\">{{ time }}</span>\n            </div>\n\n            <div class=\"card-actions\">\n              <router-link\n                :to=\"{ path: '/tickets', query: { experience: exp.id } }\"\n                class=\"btn btn-orange btn-sm\"\n              >\n                Book\n              </router-link>\n              <router-link\n                :to=\"{ path: '/animals', query: { zone: exp.zoneId } }\"\n                class=\"see\"\n              >\n                Meet the animals →\n              </router-link>\n            </div>\n          </div>\n        </article>\n      </div>\n\n      <p v-else class=\"empty\">No experience matches this filter.</p>\n\n      <p class=\"note\">\n        Experiences are added to your entrance ticket. You can book both on the\n        <router-link to=\"/tickets\">Tickets page</router-link>.\n      </p>\n\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.exp-page {\n  min-height: 100vh;\n  padding-bottom: 60px;\n  background: var(--meadow);\n}\n\n.content {\n  padding-top: 44px;\n}\n\n/* Vedette */\n\n.featured {\n  display: grid;\n  grid-template-columns: 300px 1fr;\n  overflow: hidden;\n  background: var(--forest);\n  color: #fff;\n  border-radius: 48px 8px 48px 8px;\n}\n\n.featured-art {\n  display: grid;\n  place-items: center;\n  font-size: 7rem;\n}\n\n.featured-body {\n  padding: 40px;\n}\n\n.flag {\n  display: inline-block;\n  padding: 4px 14px;\n  border-radius: 999px;\n  background: var(--orange);\n  font-size: 0.8rem;\n  font-weight: 700;\n}\n\n.featured-body h2 {\n  margin: 14px 0 10px;\n  font-size: clamp(1.8rem, 3.5vw, 2.5rem);\n}\n\n.featured-body > p {\n  color: var(--mint);\n}\n\n.facts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin: 20px 0;\n}\n\n.facts span {\n  padding: 6px 14px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.12);\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.includes {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));\n  gap: 4px 20px;\n  margin: 0 0 22px;\n  padding: 0;\n  list-style: none;\n}\n\n.includes li {\n  position: relative;\n  padding: 4px 0 4px 24px;\n}\n\n.includes li::before {\n  content: '✔';\n  position: absolute;\n  left: 0;\n  color: var(--leaf);\n  font-weight: 700;\n}\n\n.times {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 22px;\n}\n\n.times small {\n  color: inherit;\n  opacity: 0.75;\n  font-weight: 700;\n}\n\n.time {\n  padding: 3px 12px;\n  border: 1px solid currentColor;\n  border-radius: 999px;\n  font-size: 0.85rem;\n  font-weight: 700;\n}\n\n/* Filtres */\n\n.filters {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin: 44px 0 26px;\n}\n\n.filter {\n  padding: 9px 20px;\n  border: 2px solid var(--green);\n  border-radius: 999px;\n  background: transparent;\n  color: var(--green);\n  font-family: var(--font-body);\n  font-size: 0.95rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: background-color 0.2s, color 0.2s;\n}\n\n.filter:hover,\n.filter.on {\n  background: var(--green);\n  color: #fff;\n}\n\n/* Grille */\n\n.grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 28px;\n}\n\n.card {\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background: #fff;\n  border-radius: var(--leaf-radius);\n  box-shadow: var(--shadow);\n  transition: box-shadow 0.2s;\n}\n\n.card:hover {\n  box-shadow: 0 0 0 2px var(--green), var(--shadow);\n}\n\n.card-top {\n  position: relative;\n  height: 130px;\n  padding: 14px;\n}\n\n.zone-chip {\n  display: inline-block;\n  padding: 3px 12px;\n  border-radius: 999px;\n  background: #fff;\n  color: var(--forest);\n  font-size: 0.76rem;\n  font-weight: 700;\n}\n\n.card-emoji {\n  position: absolute;\n  right: 20px;\n  bottom: 10px;\n  font-size: 3.6rem;\n  line-height: 1;\n}\n\n.card-body {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  padding: 22px 24px 24px;\n}\n\n.card-body h3 {\n  color: var(--forest);\n  font-size: 1.35rem;\n}\n\n.card-body > p {\n  margin-top: 8px;\n  color: var(--muted);\n  font-size: 0.93rem;\n}\n\n.meta {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin: 16px 0 12px;\n  padding-top: 14px;\n  border-top: 1px solid var(--line);\n  color: var(--green);\n  font-size: 0.86rem;\n  font-weight: 700;\n}\n\n.meta strong {\n  margin-left: auto;\n  color: var(--orange);\n  font-family: var(--font-display);\n  font-size: 1.25rem;\n}\n\n.card .times {\n  margin-bottom: 18px;\n  color: var(--green);\n}\n\n.card-actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: auto;\n}\n\n.see {\n  color: var(--orange);\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.see:hover {\n  color: var(--orange-dark);\n  text-decoration: underline;\n}\n\n.empty {\n  padding: 40px 0;\n  color: var(--muted);\n  text-align: center;\n}\n\n.note {\n  margin-top: 40px;\n  color: var(--muted);\n  text-align: center;\n}\n\n.note a {\n  color: var(--orange);\n  font-weight: 700;\n  text-decoration: underline;\n}\n\n@media (max-width: 800px) {\n  .featured {\n    grid-template-columns: 1fr;\n  }\n\n  .featured-art {\n    height: 160px;\n    font-size: 5rem;\n  }\n\n  .featured-body {\n    padding: 28px 24px;\n  }\n}\n</style>"],"mappings":";;;AACA,OAAOA,KAAI,MAAO,oBAAmB;AACrC,SAASC,WAAU,QAAS,oBAAmB;AAC/C,SAASC,SAAS,EAAEC,cAAa,QAAS,mBAAkB;AAC5D,OAAOC,UAAS,MAAO,6BAA4B;AAEnD,eAAe;EACbC,IAAI,EAAE,iBAAiB;EAEvBC,UAAU,EAAE;IAAEF;EAAW,CAAC;EAE1BG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLP,KAAK;MACLQ,MAAM,EAAE,KAAK;MACbC,OAAO,EAAE,CACP;QAAEC,EAAE,EAAE,KAAK;QAAEC,KAAK,EAAE;MAAM,CAAC,EAC3B;QAAED,EAAE,EAAE,MAAM;QAAEC,KAAK,EAAE;MAAe,CAAC,EACrC;QAAED,EAAE,EAAE,OAAO;QAAEC,KAAK,EAAE;MAAiB;IAE3C;EACF,CAAC;EAEDC,QAAQ,EAAE;IACRC,QAAQA,CAAA,EAAG;MACT,OAAOZ,WAAW,CAACa,IAAI,CAACC,CAAA,IAAKA,CAAC,CAACF,QAAQ;IACzC,CAAC;IAED;IACAG,OAAOA,CAAA,EAAG;MACR,OAAOf,WAAW,CAACO,MAAM,CAACO,CAAA,IAAK;QAC7B,IAAIA,CAAC,CAACF,QAAQ,EAAE,OAAO,KAAI;QAC3B,IAAI,IAAI,CAACL,MAAK,KAAM,MAAM,EAAE,OAAOO,CAAC,CAACE,MAAK,IAAK;QAC/C,IAAI,IAAI,CAACT,MAAK,KAAM,OAAO,EAAE,OAAOO,CAAC,CAACE,MAAK,GAAI;QAC/C,OAAO,IAAG;MACZ,CAAC;IACH;EACF,CAAC;EAEDC,OAAO,EAAE;IACPhB,SAAS;IACTC,cAAc;IAEdgB,QAAQA,CAACC,MAAM,EAAE;MACf,MAAMC,IAAG,GAAI,IAAI,CAACrB,KAAK,CAACc,IAAI,CAACQ,CAAA,IAAKA,CAAC,CAACC,OAAM,KAAMH,MAAM;MACtD,OAAOC,IAAG,GAAIA,IAAI,CAACG,SAAQ,GAAI,EAAC;IAClC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}