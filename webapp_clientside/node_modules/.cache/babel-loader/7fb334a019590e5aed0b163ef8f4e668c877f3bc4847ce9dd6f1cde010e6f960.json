{"ast":null,"code":"import animals from '@/assets/ANIMAL.json';\nexport default {\n  data() {\n    return {\n      animals: animals\n    };\n  }\n};","map":{"version":3,"names":["animals","data"],"sources":["/Users/jackyzhang/webapp_clientside/src/views/AnimalList.vue"],"sourcesContent":["<script>\nimport animals from '@/assets/ANIMAL.json'\n\nexport default {\n  data() {\n    return {\n      animals: animals\n    }\n  }\n}\n</script>\n\n<template>\n  <div class=\"animals-page\">\n    <header class=\"page-header\">\n      <h1>🦁 Our Animals</h1>\n      <p>Discover the wonderful animals living at HappyZoo</p>\n    </header>\n\n    <div class=\"animals-grid\">\n      <div\n        v-for=\"animal in animals\"\n        :key=\"animal.id_animal\"\n        class=\"animal-card\"\n      >\n        <div class=\"animal-icon\">\n          🐾\n        </div>\n\n        <div class=\"animal-content\">\n          <h2>{{ animal.species_animal }}</h2>\n\n          <p class=\"description\">\n            {{ animal.description_animal }}\n          </p>\n\n          <div class=\"animal-info\">\n            <div class=\"info-item\">\n              <span class=\"label\">Gender</span>\n              <span class=\"value\">{{ animal.gender_animal }}</span>\n            </div>\n\n            <div class=\"info-item\">\n              <span class=\"label\">Habitat</span>\n              <span class=\"value\">{{ animal.habitat_animal }}</span>\n            </div>\n\n            <div class=\"info-item\">\n              <span class=\"label\">Length</span>\n              <span class=\"value\">{{ animal.length_animal }} m</span>\n            </div>\n\n            <div class=\"info-item\">\n              <span class=\"label\">Height</span>\n              <span class=\"value\">{{ animal.height_animal }} m</span>\n            </div>\n\n            <div class=\"info-item\">\n              <span class=\"label\">Weight</span>\n              <span class=\"value\">{{ animal.weight_animal }} kg</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n.animals-page {\n  min-height: 100vh;\n  padding: 50px 8%;\n  background: #f4f7f2;\n}\n\n/* Header */\n\n.page-header {\n  text-align: center;\n  margin-bottom: 50px;\n}\n\n.page-header h1 {\n  margin: 0;\n  font-size: 42px;\n  color: #245c3a;\n}\n\n.page-header p {\n  margin-top: 12px;\n  font-size: 18px;\n  color: #68756d;\n}\n\n/* Grid */\n\n.animals-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 25px;\n}\n\n/* Card */\n\n.animal-card {\n  background: white;\n  border-radius: 18px;\n  overflow: hidden;\n  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\n}\n\n.animal-card:hover {\n  transform: translateY(-7px);\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.14);\n}\n\n/* Top of card */\n\n.animal-icon {\n  height: 120px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 55px;\n  background: linear-gradient(135deg, #dcefdc, #b9dfc0);\n}\n\n/* Content */\n\n.animal-content {\n  padding: 25px;\n}\n\n.animal-content h2 {\n  margin: 0 0 12px;\n  font-size: 24px;\n  color: #245c3a;\n}\n\n.description {\n  color: #68756d;\n  line-height: 1.6;\n  min-height: 75px;\n}\n\n/* Information */\n\n.animal-info {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-top: 20px;\n}\n\n.info-item {\n  background: #f4f7f2;\n  border-radius: 10px;\n  padding: 10px;\n}\n\n.label {\n  display: block;\n  font-size: 12px;\n  color: #7b887f;\n  margin-bottom: 4px;\n}\n\n.value {\n  display: block;\n  font-weight: bold;\n  color: #245c3a;\n}\n\n/* Mobile */\n\n@media (max-width: 600px) {\n  .animals-page {\n    padding: 30px 20px;\n  }\n\n  .page-header h1 {\n    font-size: 32px;\n  }\n\n  .animals-grid {\n    grid-template-columns: 1fr;\n  }\n}\n</style>"],"mappings":"AACA,OAAOA,OAAM,MAAO,sBAAqB;AAEzC,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLD,OAAO,EAAEA;IACX;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}