{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport animals from '@/assets/ANIMAL.json';\nimport zones from '@/assets/ZONE.json';\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle';\nexport default {\n  name: 'HelloWorld',\n  data() {\n    return {\n      animals,\n      zones\n    };\n  },\n  computed: {\n    // Aquarium, Savannah, Arctic : les 3 zones mises en avant sur l'accueil\n    featuredZones() {\n      return [1, 2, 5].map(id => this.zones.find(zone => zone.id_zone === id)).filter(Boolean);\n    }\n  },\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n    countAnimals(idZone) {\n      return this.animals.filter(animal => animal.id_zone === idZone).length;\n    }\n  }\n};","map":{"version":3,"names":["animals","zones","zoneEmoji","zoneBackground","name","data","computed","featuredZones","map","id","find","zone","id_zone","filter","Boolean","methods","countAnimals","idZone","animal","length"],"sources":["/Users/jackyzhang/webapp_clientside/src/components/HelloWord.vue"],"sourcesContent":["<template>\n  <div class=\"happyzoo-wrapper\">\n    <!-- ========== BANNIÈRE ========== -->\n    <section class=\"grand-banner\">\n      <div class=\"container contenu-banner\">\n        <span class=\"petit-badge\">An unforgettable adventure</span>\n        <h1>Explore wildlife closer to nature</h1>\n        <p>\n          Wander through {{ zones.length }} themed zones and meet\n          {{ animals.length }} fascinating animals.\n        </p>\n\n        <div class=\"bloc-boutons\">\n          <router-link to=\"/#tarifs\" class=\"bouton-reserver grand-bouton\">Get my tickets</router-link>\n          <router-link to=\"/zones\" class=\"bouton-decouvrir grand-bouton\">Discover the zones</router-link>\n        </div>\n\n        <!-- Chiffres cliquables, calculés à partir des fichiers JSON -->\n        <div class=\"stats\">\n          <router-link to=\"/animals\" class=\"stat\">\n            <strong>{{ animals.length }}</strong>\n            <span>Animals</span>\n          </router-link>\n          <router-link to=\"/zones\" class=\"stat\">\n            <strong>{{ zones.length }}</strong>\n            <span>Zones</span>\n          </router-link>\n          <div class=\"stat stat-info\">\n            <strong>09:30</strong>\n            <span>Open every day</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ========== ZONES MISES EN AVANT ========== -->\n    <section id=\"zones\" class=\"section-zones\">\n      <div class=\"container\">\n        <div class=\"titre-section\">\n          <span class=\"tag-titre\">Trails &amp; Habitats</span>\n          <h2>Explore our Thematic Zones</h2>\n          <p>Each zone is specially designed to respect the natural biotope of our residents.</p>\n        </div>\n\n        <div class=\"grille-3-colonnes\">\n          <article v-for=\"zone in featuredZones\" :key=\"zone.id_zone\" class=\"carte-zone\">\n            <div class=\"boite-image\" :style=\"{ background: zoneBackground(zone.id_zone) }\">\n              <span class=\"etiquette\">{{ zone.theme_zone }}</span>\n              <span class=\"emoji-zone\" aria-hidden=\"true\">{{ zoneEmoji(zone.id_zone) }}</span>\n            </div>\n            <div class=\"contenu-texte\">\n              <h3>{{ zone.name_zone }}</h3>\n              <p>{{ zone.description_zone }}</p>\n\n              <div class=\"info-surface\">\n                <span>{{ zone.place_zone }}</span>\n                <span>{{ countAnimals(zone.id_zone) }} animals</span>\n              </div>\n\n              <router-link\n                :to=\"{ path: '/animals', query: { zone: zone.id_zone } }\"\n                class=\"lien-zone\"\n              >\n                See the animals\n              </router-link>\n            </div>\n          </article>\n        </div>\n\n        <div class=\"voir-tout\">\n          <router-link to=\"/zones\" class=\"bouton-decouvrir\">See all {{ zones.length }} zones</router-link>\n          <router-link to=\"/animals\" class=\"bouton-contour\">Meet all the animals</router-link>\n        </div>\n      </div>\n    </section>\n\n    <!-- ========== EXPÉRIENCE ========== -->\n    <section id=\"activites\" class=\"section-soigneur\">\n      <div class=\"container bloc-promo\">\n        <div class=\"texte-promo\">\n          <span class=\"tag-titre\">Closer to the beasts</span>\n          <h2>Become a Keeper for a Day</h2>\n          <p>\n            Take part in supervised feeding with our animal team and understand the\n            lifestyle and diet of our favorite species.\n          </p>\n\n          <a href=\"#\" class=\"bouton-reserver\" @click.prevent>Book a workshop</a>\n        </div>\n        <div class=\"image-promo\">\n          <img\n            src=\"https://images.unsplash.com/photo-1535268647677-300dbf3d78d1?auto=format&amp;fit=crop&amp;w=800&amp;q=80\"\n            alt=\"Animal interaction\"\n          />\n        </div>\n      </div>\n    </section>\n\n    <!-- ========== BILLETS ========== -->\n    <section id=\"tarifs\" class=\"section-tarifs fond-gris\">\n      <div class=\"container\">\n        <div class=\"titre-section\">\n          <span class=\"tag-titre\">Online Ticketing</span>\n          <h2>Choose Your Package</h2>\n          <p>Buy your tickets in advance to avoid waiting at the checkout.</p>\n        </div>\n\n        <div class=\"grille-3-colonnes\">\n          <div class=\"billet1\">\n            <h3>Child Ticket</h3>\n            <p class=\"sous-titre\">3 to 12 years old included</p>\n            <div class=\"prix\">14€<span>/pers</span></div>\n            <ul class=\"liste-avantages\">\n              <li>✔ Full access to zones</li>\n              <li>✔ Animations &amp; animated snacks</li>\n              <li>✔ Fun map included</li>\n            </ul>\n            <button class=\"bouton-acheter\">Buy</button>\n          </div>\n\n          <div class=\"billet2 populaire\">\n            <span class=\"tag-populaire\">Most popular</span>\n            <h3>Adult Ticket</h3>\n            <p class=\"sous-titre\">From 13 years old</p>\n            <div class=\"prix\">22€<span>/pers</span></div>\n            <ul class=\"liste-avantages\">\n              <li>✔ Unlimited access to all zones</li>\n              <li>✔ Access to educational shows</li>\n              <li>✔ Skip-the-line entry</li>\n            </ul>\n            <button class=\"bouton-acheter full-btn\">Buy</button>\n          </div>\n\n          <div class=\"billet3\">\n            <h3>Family Pass</h3>\n            <p class=\"sous-titre\">2 Adults + 2 Children</p>\n            <div class=\"prix\">62€<span>/pack</span></div>\n            <ul class=\"liste-avantages\">\n              <li>✔ Advantageous combined ticket</li>\n              <li>✔ Interactive mobile guide</li>\n              <li>✔ 10% off in our restaurants</li>\n            </ul>\n            <button class=\"bouton-acheter\">Buy</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ========== PIED DE PAGE ========== -->\n    <footer class=\"pied-de-page\">\n      <div class=\"container colonnes-footer\">\n        <div class=\"colonne1\">\n          <div class=\"mon-logo\">🌿 Happy<span>Zoo</span></div>\n          <p>A park committed to wildlife preservation and public awareness.</p>\n        </div>\n        <div class=\"colonne2\">\n          <h4>Navigation</h4>\n          <ul>\n            <li><router-link to=\"/animals\">The Animals</router-link></li>\n            <li><router-link to=\"/zones\">The Zones</router-link></li>\n            <li><router-link to=\"/#activites\">Experiences</router-link></li>\n            <li><router-link to=\"/#tarifs\">Tickets &amp; Prices</router-link></li>\n          </ul>\n        </div>\n        <div class=\"colonne3\">\n          <h4>Opening Hours</h4>\n          <p>Monday to Sunday<br />09:30 AM to 06:30 PM</p>\n          <p>Ticket offices close at 05:00 PM</p>\n        </div>\n        <div class=\"colonne4\">\n          <h4>Contact</h4>\n          <p>📍 Reserve Road, 75000 Paris</p>\n          <p>📞 01 23 45 67 89</p>\n          <p>✉ contact@zoowildlife.fr</p>\n        </div>\n      </div>\n      <div class=\"bas-du-footer\">\n        <p>&copy; 2026 HappyZoo. All rights reserved.</p>\n      </div>\n    </footer>\n  </div>\n</template>\n\n<script>\nimport animals from '@/assets/ANIMAL.json'\nimport zones from '@/assets/ZONE.json'\nimport { zoneEmoji, zoneBackground } from '@/utils/zoneStyle'\n\nexport default {\n  name: 'HelloWorld',\n\n  data() {\n    return {\n      animals,\n      zones\n    }\n  },\n\n  computed: {\n    // Aquarium, Savannah, Arctic : les 3 zones mises en avant sur l'accueil\n    featuredZones() {\n      return [1, 2, 5]\n        .map(id => this.zones.find(zone => zone.id_zone === id))\n        .filter(Boolean)\n    }\n  },\n\n  methods: {\n    zoneEmoji,\n    zoneBackground,\n    countAnimals(idZone) {\n      return this.animals.filter(animal => animal.id_zone === idZone).length\n    }\n  }\n}\n</script>\n\n<style scoped>\n.happyzoo-wrapper {\n  font-family: Arial, sans-serif;\n  color: #1c2421;\n  background-color: #ffffff;\n  line-height: 1.5;\n}\n\nimg {\n  max-width: 100%;\n  height: auto;\n}\n\na {\n  text-decoration: none;\n  color: inherit;\n  transition: all 0.2s ease-in-out;\n}\n\nh1, h2, h3, h4, p, ul {\n  margin: 0;\n}\n\nul {\n  padding: 0;\n  list-style: none;\n}\n\n.container {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 0 15px;\n}\n\n/* ---------- Boutons ---------- */\n\n.bouton-reserver,\n.bouton-decouvrir,\n.bouton-contour,\n.bouton-acheter {\n  display: inline-block;\n  padding: 12px 22px;\n  font-size: 0.95rem;\n  font-weight: bold;\n  border-radius: 6px;\n  cursor: pointer;\n  border: 2px solid transparent;\n  text-align: center;\n  transition: all 0.2s ease-in-out;\n}\n\n.bouton-reserver,\n.bouton-acheter.full-btn {\n  background-color: #d97706;\n  color: #ffffff;\n}\n\n.bouton-reserver:hover,\n.bouton-acheter.full-btn:hover {\n  background-color: #b45309;\n}\n\n.bouton-decouvrir {\n  background-color: #2d6a4f;\n  color: #ffffff;\n}\n\n.bouton-decouvrir:hover {\n  background-color: #1b4332;\n}\n\n.bouton-contour,\n.bouton-acheter {\n  border-color: #2d6a4f;\n  background-color: transparent;\n  color: #2d6a4f;\n}\n\n.bouton-contour:hover,\n.bouton-acheter:hover {\n  background-color: #2d6a4f;\n  color: #ffffff;\n}\n\n.bouton-acheter {\n  width: 100%;\n}\n\n:focus-visible {\n  outline: 3px solid #d97706;\n  outline-offset: 2px;\n}\n\n/* ---------- Bannière ---------- */\n\n.petit-badge {\n  display: inline-block;\n  background-color: #f3eee7;\n  color: #1e3a2b;\n  padding: 5px 12px;\n  font-size: 0.8rem;\n  font-weight: bold;\n  border-radius: 20px;\n  margin-bottom: 10px;\n}\n\n.grand-banner {\n  background-color: #1e3a2b;\n  color: #ffffff;\n  padding: 80px 0 60px;\n  text-align: center;\n}\n\n.grand-banner h1 {\n  font-size: 2.8rem;\n  color: #ffffff;\n  margin-bottom: 15px;\n}\n\n.grand-banner p {\n  font-size: 1.15rem;\n  color: #f3eee7;\n  margin-bottom: 30px;\n}\n\n.bloc-boutons {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.stats {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 16px;\n  margin-top: 50px;\n}\n\n.stat {\n  min-width: 150px;\n  padding: 14px 24px;\n  border: 1px solid rgba(255, 255, 255, 0.25);\n  border-radius: 12px;\n  text-align: center;\n}\n\na.stat:hover {\n  background-color: rgba(255, 255, 255, 0.1);\n  border-color: #d97706;\n}\n\n.stat strong {\n  display: block;\n  font-size: 2rem;\n  color: #ffffff;\n}\n\n.stat span {\n  color: #f3eee7;\n  font-size: 0.9rem;\n}\n\n/* ---------- Sections ---------- */\n\n.section-zones,\n.section-soigneur,\n.section-tarifs {\n  padding: 60px 0;\n}\n\n.fond-gris {\n  background-color: #fdfbf7;\n}\n\n.titre-section {\n  text-align: center;\n  margin-bottom: 40px;\n}\n\n.tag-titre {\n  color: #d97706;\n  font-weight: bold;\n  font-size: 0.85rem;\n  text-transform: uppercase;\n}\n\n.titre-section h2 {\n  font-size: 2.2rem;\n  color: #1e3a2b;\n  margin: 5px 0;\n}\n\n.titre-section p {\n  color: #526058;\n}\n\n.grille-3-colonnes {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 25px;\n  justify-content: center;\n}\n\n.carte-zone,\n.billet1, .billet2, .billet3 {\n  background-color: #ffffff;\n  border: 1px solid #e2ece9;\n  border-radius: 12px;\n  width: 300px;\n  flex-grow: 1;\n  box-shadow: 0 8px 20px rgba(30, 58, 43, 0.08);\n}\n\n.boite-image {\n  position: relative;\n  height: 190px;\n  padding: 12px;\n  border-top-left-radius: 12px;\n  border-top-right-radius: 12px;\n}\n\n.etiquette {\n  background-color: #ffffff;\n  color: #1e3a2b;\n  padding: 4px 10px;\n  font-size: 0.8rem;\n  font-weight: bold;\n  border-radius: 4px;\n}\n\n.emoji-zone {\n  position: absolute;\n  right: 20px;\n  bottom: 14px;\n  font-size: 4rem;\n  line-height: 1;\n}\n\n.contenu-texte {\n  padding: 22px;\n}\n\n.contenu-texte h3 {\n  color: #1e3a2b;\n  margin-bottom: 8px;\n}\n\n.contenu-texte p {\n  color: #526058;\n  font-size: 0.95rem;\n  margin-bottom: 15px;\n  min-height: 46px;\n}\n\n.info-surface {\n  display: flex;\n  justify-content: space-between;\n  font-weight: bold;\n  color: #2d6a4f;\n  border-top: 1px solid #e2ece9;\n  padding-top: 12px;\n  font-size: 0.85rem;\n}\n\n.lien-zone {\n  display: inline-block;\n  margin-top: 14px;\n  font-weight: bold;\n  color: #d97706;\n}\n\n.lien-zone:hover {\n  color: #b45309;\n  text-decoration: underline;\n}\n\n.voir-tout {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 15px;\n  margin-top: 40px;\n}\n\n/* ---------- Promo ---------- */\n\n.bloc-promo {\n  background-color: #1e3a2b;\n  color: #ffffff;\n  border-radius: 20px;\n  padding: 40px;\n  display: flex;\n  gap: 30px;\n  align-items: center;\n}\n\n.texte-promo {\n  flex: 1;\n}\n\n.texte-promo .tag-titre {\n  color: #d97706;\n}\n\n.texte-promo h2 {\n  color: #ffffff;\n  font-size: 2rem;\n  margin: 10px 0;\n}\n\n.texte-promo p {\n  color: #f3eee7;\n  margin-bottom: 20px;\n}\n\n.image-promo {\n  flex: 1;\n}\n\n.image-promo img {\n  border-radius: 12px;\n}\n\n/* ---------- Billets ---------- */\n\n.billet1,\n.billet2,\n.billet3 {\n  padding: 30px;\n  text-align: center;\n}\n\n.billet2.populaire {\n  border: 2px solid #d97706;\n  background-color: #ffffff;\n}\n\n.tag-populaire {\n  background-color: #d97706;\n  color: #ffffff;\n  font-weight: bold;\n  padding: 4px 12px;\n  font-size: 0.75rem;\n  border-radius: 12px;\n  margin-bottom: 12px;\n  display: inline-block;\n  text-transform: uppercase;\n}\n\n.prix {\n  font-size: 2.4rem;\n  font-weight: bold;\n  color: #1e3a2b;\n  margin: 15px 0;\n}\n\n.prix span {\n  font-size: 0.9rem;\n  color: #526058;\n}\n\n.liste-avantages {\n  text-align: left;\n  margin-bottom: 25px;\n}\n\n.liste-avantages li {\n  padding: 8px 0;\n  border-bottom: 1px solid #e2ece9;\n  font-size: 0.9rem;\n  color: #526058;\n}\n\n/* ---------- Pied de page ---------- */\n\n.pied-de-page {\n  background-color: #1e3a2b;\n  color: #f3eee7;\n  padding: 50px 0 20px;\n}\n\n.mon-logo {\n  font-size: 1.8rem;\n  font-weight: bold;\n  color: #ffffff;\n}\n\n.mon-logo span {\n  color: #d97706;\n}\n\n.colonnes-footer {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 30px;\n  justify-content: space-between;\n  margin-bottom: 40px;\n}\n\n.colonne1, .colonne2, .colonne3, .colonne4 {\n  flex: 1;\n  min-width: 200px;\n}\n\n.colonne2 h4, .colonne3 h4, .colonne4 h4 {\n  color: #ffffff;\n  margin-bottom: 15px;\n  font-size: 1.1rem;\n}\n\n.colonne2 ul li {\n  margin-bottom: 10px;\n}\n\n.colonne2 a:hover {\n  color: #d97706;\n}\n\n.bas-du-footer {\n  text-align: center;\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\n  padding-top: 20px;\n  font-size: 0.85rem;\n  color: #a9b8ae;\n}\n\n@media (max-width: 768px) {\n  .grand-banner h1 {\n    font-size: 2.1rem;\n  }\n\n  .bloc-promo {\n    flex-direction: column;\n    padding: 25px;\n  }\n}\n</style>"],"mappings":";;;AAwLA,OAAOA,OAAM,MAAO,sBAAqB;AACzC,OAAOC,KAAI,MAAO,oBAAmB;AACrC,SAASC,SAAS,EAAEC,cAAa,QAAS,mBAAkB;AAE5D,eAAe;EACbC,IAAI,EAAE,YAAY;EAElBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLL,OAAO;MACPC;IACF;EACF,CAAC;EAEDK,QAAQ,EAAE;IACR;IACAC,aAAaA,CAAA,EAAG;MACd,OAAO,CAAC,CAAC,EAAE,CAAC,EAAE,CAAC,EACZC,GAAG,CAACC,EAAC,IAAK,IAAI,CAACR,KAAK,CAACS,IAAI,CAACC,IAAG,IAAKA,IAAI,CAACC,OAAM,KAAMH,EAAE,CAAC,EACtDI,MAAM,CAACC,OAAO;IACnB;EACF,CAAC;EAEDC,OAAO,EAAE;IACPb,SAAS;IACTC,cAAc;IACda,YAAYA,CAACC,MAAM,EAAE;MACnB,OAAO,IAAI,CAACjB,OAAO,CAACa,MAAM,CAACK,MAAK,IAAKA,MAAM,CAACN,OAAM,KAAMK,MAAM,CAAC,CAACE,MAAK;IACvE;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}